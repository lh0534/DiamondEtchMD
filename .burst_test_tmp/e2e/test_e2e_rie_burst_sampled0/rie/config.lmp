# DiamondEtchMD generated config (single-species)
# orientation=100  surface=2x1
# species=O  energy=20.0eV  ion_angle=0.0deg  T=300.0K

variable    ML equal 16            # atoms per monolayer
variable    end_fluence equal 0.125   # in ML

variable    energ equal 20.0     # incident energy per atom (eV)
variable    ion_angl equal 0.0   # ion beam angle (deg from normal)
variable    ion_azimuth equal 90.0  # ion beam azimuth (deg; 90=YZ plane)
variable    T equal 300.0    # substrate temperature (K)
variable    pot string REAX

variable    use_starting_data_file equal false
variable    starting_data_file string data.truncated

if "${pot} == REAX" then &
"variable    lat_a file lat_a.txt"

variable    x equal 4
variable    y equal 4
variable    lat_top equal 2
variable    z equal ${lat_top}+5

variable    reconstruct equal true
variable    O_terminate equal false
variable    O_ether_terminate equal false

variable    i_above equal 6.0    # Å above surface to inject ion
variable    impact_time equal 200.0
variable    thermalization_time equal 100.0

variable    M_C equal 12.011
variable    M_H equal 1.00784
variable    M_O equal 16.0
variable    M_incident equal ${M_O}
variable    incident_type_index equal 3  # O

variable    seed_adjust equal 0
variable    simdepo equal 1

# RIE-etch: O• radical pre-exposure before each ion impact
variable    flux_ratio equal 6
variable    kT_rad equal 0.04463779        # eV = kB * 518 K
# radical energy distribution: striking flux, E*exp(-E/kT)
variable    radical_e_thresh equal 0.05  # eV; total-energy draws below this are skipped
variable    radical_i_above equal 6.0
variable    max_inter_neutral_time equal 5000.0
variable    inter_neutral_time equal 200.0

# Step edge
variable    step_edge      equal 0
variable    step_angle     equal 0.0
variable    step_position   equal 0.5
variable    step_position_2 equal 1.0
variable    step_invert    equal 0
variable    step_depth_ang equal 2.0

# Sweep options
variable    above_surf_eject   equal 1
variable    co2_desorb_fraction equal 0.0
