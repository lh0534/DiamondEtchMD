# DiamondEtchMD generated config (cycling mode)
# orientation=100  surface=2x1  T=300.0K
# phases: Ar@50eV×1ML, O@15eV×1ML+O•R6
# 1 cycle(s) × 2 ML/cycle = 2 ML total

variable    ML equal 16            # atoms per monolayer
variable    cycles equal 1
variable    end_fluence equal 0.1875  # total ML

variable    ion_angl equal 0.0   # ion beam angle (deg from normal)
variable    ion_azimuth equal 90.0  # ion beam azimuth (deg; 90=YZ plane)
variable    T equal 300.0    # substrate temperature (K)
variable    pot string REAX

variable    use_starting_data_file equal false
variable    starting_data_file string data.truncated

if "${pot} == REAX" then &
"variable    lat_a file lat_a.txt"

variable    x equal 4
variable    y equal 4
variable    lat_top equal 2
variable    z equal ${lat_top}+5

variable    reconstruct equal true
variable    O_terminate equal false
variable    O_ether_terminate equal false

variable    impact_time equal 200
variable    thermalization_time equal 100

variable    ion_i_above equal 6.0     # Å above surface to inject ion
variable    radical_i_above equal 6.0  # Å above surface to inject O• radical

variable    M_C equal 12.011
variable    M_H equal 1.00784
variable    M_O equal 16.0
variable    M_Ar equal 39.948

variable    seed_adjust equal 0

# Per-phase parameters
variable    phase_0_ml equal 0.0625       # ML per cycle (Ar)
variable    phase_0_energy equal 50.0 # eV/atom
variable    phase_0_flux_ratio equal 0
variable    phase_1_ml equal 0.125       # ML per cycle (O)
variable    phase_1_energy equal 15.0 # eV/atom
variable    phase_1_flux_ratio equal 6
variable    phase_1_kT_rad equal 0.04463779        # eV = kB * 518 K
# phase_1_radical energy distribution: striking flux, E*exp(-E/kT)
variable    phase_1_radical_e_thresh equal 0.05  # eV; total-energy draws below this are skipped
variable    phase_1_radical_i_above equal 6.0
variable    phase_1_max_inter_neutral_time equal 5000.0
variable    phase_1_inter_neutral_time equal 1500.0

# Step edge
variable    step_edge      equal 0
variable    step_angle     equal 0.0
variable    step_position   equal 0.5
variable    step_position_2 equal 1.0
variable    step_invert    equal 0
variable    step_depth_ang equal 2.0

# Sweep options
variable    above_surf_eject   equal 1
variable    co2_desorb_fraction equal 0.0
