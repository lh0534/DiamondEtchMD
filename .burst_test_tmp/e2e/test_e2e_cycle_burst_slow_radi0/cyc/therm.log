
timestep 	0.25

label setuploop
# Slabs span the carbon, not the box: zlo can run far below the atoms (an atom
# escaping downward drags the shrink-wrapped boundary with it), and the old
# bottom*lat_a/sqrt(2) start drifted above the true bottom as the box grew.
variable dz equal ceil(($(bound(carbon,zmax))-$(bound(carbon,zmin)))/16) #16 groups max to prevent going over 36 total
variable dz equal ceil((10.158089460513984648-$(bound(carbon,zmin)))/16) 
variable dz equal ceil((10.158089460513984648--1.6669866956322634266)/16) 
if "${dz}<5" then "variable dz equal 5" # minimum lat_a
variable dz equal 5
variable zbottom equal $(floor(bound(carbon,zmin)))
variable zbottom equal -2
variable zbottom0 equal $(v_zbottom)
variable zbottom0 equal -2
# =============================== begin thermostat setting loop ==========
label set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _2
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal -2+${dz}
variable ztop equal -2+5
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r_2 block INF INF INF INF ${zbottom} ${ztop} units box
region r_2 block INF INF INF INF -2 ${ztop} units box
region r_2 block INF INF INF INF -2 3 units box
group temp_rgn region r${zname}
group temp_rgn region r_2
96 atoms in group temp_rgn
group temp_c intersect temp_rgn carbon
96 atoms in group temp_c
group g${zname} subtract temp_c anchor
group g_2 subtract temp_c anchor
64 atoms in group g_2
group temp_c delete
group temp_rgn delete
region r${zname} delete
region r_2 delete
variable nregion equal count(g${zname})
variable nregion equal count(g_2)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_2 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_2 g_2 temp/berendsen $T $T $(250*dt)
fix		    t_2 g_2 temp/berendsen 300 $T $(250*dt)
fix		    t_2 g_2 temp/berendsen 300 300 $(250*dt)
fix		    t_2 g_2 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal 3
jump SELF set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 3
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal 3+${dz}
variable ztop equal 3+5
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r3 block INF INF INF INF ${zbottom} ${ztop} units box
region r3 block INF INF INF INF 3 ${ztop} units box
region r3 block INF INF INF INF 3 8 units box
group temp_rgn region r${zname}
group temp_rgn region r3
78 atoms in group temp_rgn
group temp_c intersect temp_rgn carbon
77 atoms in group temp_c
group g${zname} subtract temp_c anchor
group g3 subtract temp_c anchor
77 atoms in group g3
group temp_c delete
group temp_rgn delete
region r${zname} delete
region r3 delete
variable nregion equal count(g${zname})
variable nregion equal count(g3)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t3 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t3 g3 temp/berendsen $T $T $(250*dt)
fix		    t3 g3 temp/berendsen 300 $T $(250*dt)
fix		    t3 g3 temp/berendsen 300 300 $(250*dt)
fix		    t3 g3 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal 8
jump SELF set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 8
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal 8+${dz}
variable ztop equal 8+5
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r8 block INF INF INF INF ${zbottom} ${ztop} units box
region r8 block INF INF INF INF 8 ${ztop} units box
region r8 block INF INF INF INF 8 13 units box
group temp_rgn region r${zname}
group temp_rgn region r8
10 atoms in group temp_rgn
group temp_c intersect temp_rgn carbon
3 atoms in group temp_c
group g${zname} subtract temp_c anchor
group g8 subtract temp_c anchor
3 atoms in group g8
group temp_c delete
group temp_rgn delete
region r${zname} delete
region r8 delete
variable nregion equal count(g${zname})
variable nregion equal count(g8)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t8 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t8 g8 temp/berendsen $T $T $(250*dt)
fix		    t8 g8 temp/berendsen 300 $T $(250*dt)
fix		    t8 g8 temp/berendsen 300 300 $(250*dt)
fix		    t8 g8 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal 13
jump SELF set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 13
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal 13+${dz}
variable ztop equal 13+5
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r13 block INF INF INF INF ${zbottom} ${ztop} units box
region r13 block INF INF INF INF 13 ${ztop} units box
region r13 block INF INF INF INF 13 18 units box
group temp_rgn region r${zname}
group temp_rgn region r13
0 atoms in group temp_rgn
group temp_c intersect temp_rgn carbon
0 atoms in group temp_c
group g${zname} subtract temp_c anchor
group g13 subtract temp_c anchor
0 atoms in group g13
group temp_c delete
group temp_rgn delete
region r${zname} delete
region r13 delete
variable nregion equal count(g${zname})
variable nregion equal count(g13)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
# note thermostat damping is 250x the timestep, 10% of the thermostat time
# ================================= end thermostat setting loop ==========

# unset empty group and region
variable zbottom_final equal ${zbottom}
variable zbottom_final equal 13
group g${zname} delete
group g13 delete

# run thermostats
log ${log_file} append # ok log this part
log log1.lammps append 

variable zbottom equal ${zbottom0}
variable zbottom equal -2
# no thermostat was set if the first slab had no mobile carbon
if "${zbottom_final} == ${zbottom0}" then "jump SELF unset_loop_done"
# =============================== begin thermostat UNsetting loop ========
label unset_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _2
unfix t${zname}
unfix t_2
group g${zname} delete
group g_2 delete
variable zbottom equal ${zbottom}+${dz}
variable zbottom equal -2+${dz}
variable zbottom equal -2+5
if "${zbottom}!=${zbottom_final}" then "jump SELF unset_loop_start"
jump SELF unset_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 3
unfix t${zname}
unfix t3
group g${zname} delete
group g3 delete
variable zbottom equal ${zbottom}+${dz}
variable zbottom equal 3+${dz}
variable zbottom equal 3+5
if "${zbottom}!=${zbottom_final}" then "jump SELF unset_loop_start"
jump SELF unset_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 8
unfix t${zname}
unfix t8
group g${zname} delete
group g8 delete
variable zbottom equal ${zbottom}+${dz}
variable zbottom equal 8+${dz}
variable zbottom equal 8+5
if "${zbottom}!=${zbottom_final}" then "jump SELF unset_loop_start"
label unset_loop_done
# ================================= end UNthermostat setting loop ========
log ${log_file} append
log log1.lammps append
