# head.lmp — generated by DiamondEtchMD (cycling mode)
# orientation=100  phases: Ar@50eV×1ML → O@15eV×1ML+O•R12
# 1 cycle(s)  T=300.0K  ion_angle=0.0deg

units       real
include     config.lmp
if "${pot} == COMB3" then &
"atom_style charge" &
elif "${pot} == REAX" &
"atom_style charge" &
else &
"atom_style atomic"

boundary    p p m

region      dummy_region block 0 1 0 1 0 1
create_box  4 dummy_region
read_data   ${data_file} add merge

# Phase boundary variables (cumulative impacts per cycle)
variable    phase_0_end equal $(v_ML*v_phase_0_ml)
variable    phase_1_end equal $(v_phase_0_end+v_ML*v_phase_1_ml)
variable    impacts_per_cycle equal ${phase_1_end}

variable    lp equal $(v_end_fluence*v_ML)-${n_complete} # impacts left
variable    a loop ${lp}
group       carbon type 1
variable    bottom equal $(-5/8-0.5*ceil(2*(-5/8-bound(carbon,zmin)/(v_lat_a))-1e-9))
label       bottom_search
region      btest block INF INF INF INF $(v_bottom*v_lat_a) $((v_bottom+0.5)*v_lat_a) units box
group       btest region btest
variable    nbtest equal $(count(btest))
group       btest delete
region      btest delete
if "${nbtest} < $(0.5*v_ML) && $(v_bottom*v_lat_a) < $(zhi)" then "variable bottom equal $(v_bottom+0.5)" "jump SELF bottom_search"
print       'BOTTOM ${bottom}'
print       'N_LAT_0 ${n_lat_0}'

# Regions
lattice    diamond ${lat_a} orient z 0 0 1 orient x 1 1 0 orient y -1 1 0 spacing $(1/sqrt(2)) $(1/sqrt(2)) 1 origin 0 0 0
region      bbox block EDGE EDGE EDGE EDGE EDGE EDGE
variable    sublat equal ${bottom}+1/2
region      anchor block INF INF INF INF ${bottom} ${sublat} units lattice

# Groups
group       anchor region anchor
group       insert empty
group       mobile subtract all anchor
group       carbon type 1

# Masses
mass        1 ${M_C}
mass        2 ${M_H}
mass        3 ${M_O}
mass        4 ${M_Ar}

# Potential
if "${pot} == REAX" then &
"pair_style  hybrid reaxff NULL zbl 5.0 6.0" &
"pair_coeff * * reaxff ffield.reax C H O NULL" &
"pair_coeff 1 4 zbl 6.0 18" &
"pair_coeff 2 4 zbl 1.0 18" &
"pair_coeff 3 4 zbl 8.0 18" &
"pair_coeff 4 4 zbl 18 18" &
"group nonargon type 1 2 3" &
"fix reax_qeq nonargon qeq/reaxff 1 0.0 6.0 1e-6 reaxff"
variable    prev_needs_zbl equal 1

# Restart state
variable    c equal ${n_complete}
variable    cn_start equal ${neut_complete}
variable    cn equal 0
variable    event_count equal ${n_events}

# Atom count diagnostics
variable    nfixed  equal count(anchor)
variable    nmobile equal count(mobile)
variable    ninject equal count(insert)

# Energy conservation check
compute     ake all ke
compute     ape all pe
compute     ike insert ke
variable    ate equal c_ake+c_ape+ecouple

# Cluster detection
variable    checkevery equal 1000
compute     clusts all cluster/atom 3.0
compute     clust_min all reduce min c_clusts
compute     clust_max all reduce max c_clusts
variable    one_clust equal "c_clust_min == c_clust_max"
fix         stopclust all halt ${checkevery} v_one_clust == 0 error continue message yes

# Carbon cluster event tracking
compute     cclusts carbon cluster/atom 1.8
compute     cc1 carbon chunk/atom c_cclusts compress yes
compute     nclusts carbon reduce max c_cc1

# Thermo
thermo_style    custom step time v_ninject temp c_ike dt ecouple v_ate v_one_clust c_nclusts
compute     mtemp mobile temp
compute_modify  mtemp dynamic/dof yes
thermo_modify   temp mtemp
thermo_modify   lost warn flush yes

print       "${c}" file begin.txt

# ========================= Begin Per-Impact Outer Loop =========================
label       loop
group nonargon type 1 2 3
if "${cn_start} > 0" then "variable cn equal ${cn_start}" else "variable cn equal 0"

# Compute position within current cycle
variable    cycle_idx equal floor(v_c/v_impacts_per_cycle)
variable    idx_in_cycle equal $(v_c-v_cycle_idx*v_impacts_per_cycle)

# Phase selection (default: phase 1 = O@15eV×1ML+O•R12)
variable current_ion_type equal 3
variable current_use_molecule equal 0
variable current_ion_energy equal ${phase_1_energy}
variable current_M_ion equal ${M_O}
variable current_phase_mix_idx equal 0
variable current_phase_idx equal 1
variable current_needs_removal equal 0
variable current_needs_zbl equal 0
variable current_phase_is_burst equal 1
variable current_flux_ratio equal ${phase_1_flux_ratio}
variable current_radical_energy equal ${phase_1_radical_energy}
variable current_rad_angl equal ${phase_1_rad_angl}
variable current_rad_azimuth equal ${phase_1_rad_azimuth}
variable current_inter_neutral_time equal ${phase_1_inter_neutral_time}

if "${idx_in_cycle} < ${phase_0_end}" then &
"variable current_ion_type equal 4" &
"variable current_use_molecule equal 0" &
"variable current_ion_energy equal ${phase_0_energy}" &
"variable current_M_ion equal ${M_Ar}" &
"variable current_phase_mix_idx equal 0" &
"variable current_phase_idx equal 0" &
"variable current_phase_is_burst equal 0" &
"variable current_flux_ratio equal ${phase_0_flux_ratio}" &
"variable current_rad_angl equal 0.0" &
"variable current_rad_azimuth equal 90.0" &
"variable current_inter_neutral_time equal 1500.0" &
"variable current_needs_removal equal 1" &
"variable current_needs_zbl equal 1"

# Ion velocities for current phase
variable    vel_ion equal sqrt(2*${current_ion_energy}*6.02214129*1.0e+7/${current_M_ion}/6242)/1000
variable    velx_ion equal sin(${ion_angl}*PI/180)*cos(${ion_azimuth}*PI/180)*${vel_ion}
variable    vely_ion equal sin(${ion_angl}*PI/180)*sin(${ion_azimuth}*PI/180)*${vel_ion}
variable    velz_ion equal cos(${ion_angl}*PI/180)*${vel_ion}

# Switch pair potential and qeq group at Ar↔non-Ar phase boundaries.
# ZBL→plain: drop hybrid pair_style; type-4 (Ar, now absent) maps to C.
if "${prev_needs_zbl} == 1 && ${current_needs_zbl} == 0" then &
"unfix reax_qeq" &
"pair_style reaxff NULL" &
"pair_coeff * * ffield.reax C H O C" &
"fix reax_qeq all qeq/reaxff 1 0.0 6.0 1e-6 reaxff"
if "${prev_needs_zbl} == 0 && ${current_needs_zbl} == 1" then &
"unfix reax_qeq" &
"pair_style hybrid reaxff NULL zbl 5.0 6.0" &
"pair_coeff * * reaxff ffield.reax C H O NULL" &
"pair_coeff 1 4 zbl 6.0 18" &
"pair_coeff 2 4 zbl 1.0 18" &
"pair_coeff 3 4 zbl 8.0 18" &
"pair_coeff 4 4 zbl 18 18" &
"fix reax_qeq nonargon qeq/reaxff 1 0.0 6.0 1e-6 reaxff"
variable prev_needs_zbl equal ${current_needs_zbl}

# Adaptive timestep (used for both neutral and ion loops)
fix         ats all dt/reset 1 NULL 1 0.01 units box

# ========================= Begin neutral deposition loop =========================
if "${current_flux_ratio} == 0" then "jump SELF skip_chem"
# ── Burst radical injection dispatch ─────────────────────────────────────────
if "${current_phase_is_burst} == 0" then "jump SELF burst_dispatch_done"
if "${cn_start} >= 1" then "jump SELF skip_chem"
if "${current_phase_idx} == 1" then "jump SELF burst_phase_1"
jump        SELF burst_dispatch_done

label       burst_phase_1
# burst: 4 chunk(s) × ≤3 atoms = 12 O• total
# cn = 1 while the burst runs: its etch products log as (c, 1), like its ncarbon row
variable    cn equal 1
timestep    1e-10
variable    n_burst_sim equal 0
variable    n_burst_fail equal 0

# --- Burst chunk 1/4: 3 atoms (deposit) ---
include     surface_top.lmp
timestep    1e-10
if "$(v_z_surf_top+v_radical_i_above+2.0) > $(zhi)" then "change_box all z delta 0 $(v_z_surf_top+v_radical_i_above+2.0-zhi) units box" "region bbox delete" "region bbox block EDGE EDGE EDGE EDGE EDGE EDGE"
variable    z_ins1_0 equal ${z_surf_top}+${radical_i_above}
region      bzone1_0 block EDGE EDGE EDGE EDGE $(v_z_ins1_0 - 0.1) $(v_z_ins1_0 + 0.1) units box
variable    n_sim_pre1_0 equal ${n_burst_sim}
variable    burst_k1_0 loop 3
label       burst_dep_1_0
variable    burst_ia equal $(0+v_burst_k1_0)
variable    bms_b equal v_c*100000+v_burst_ia+${seed_adjust}*1000000
variable    rad_e_b equal $(v_current_radical_energy)
variable    cos_th_b equal $(cos(v_current_rad_angl*PI/180))
variable    phi_b equal $(v_current_rad_azimuth*PI/180)
variable    sin_th_b equal $(sqrt(1.0-v_cos_th_b*v_cos_th_b))
variable    spd_b equal $(sqrt(2*v_rad_e_b*6.02214129*1.0e+7/v_M_O/6242)/1000)
variable    vx_burst equal $(v_spd_b*v_sin_th_b*cos(v_phi_b))
variable    vy_burst equal $(v_spd_b*v_sin_th_b*sin(v_phi_b))
variable    vz_burst equal $(-v_spd_b*v_cos_th_b)
variable    rad_sim equal 1
print       "${c} ${burst_ia} ${rad_e_b} $(acos(v_cos_th_b)*180/PI) $(v_phi_b*180/PI) ${rad_sim}" append radical_log.txt
group       insert clear
group       mobile subtract all anchor
variable    burst_seed equal floor(random(1,72099+${seed_adjust},${c}*100000+${burst_ia}))
fix         burst_depo insert deposit 1 3 1 ${burst_seed} attempt 5000 vx ${vx_burst} ${vx_burst} vy ${vy_burst} ${vy_burst} vz ${vz_burst} ${vz_burst} region bzone1_0 near 3.5 units box
fix         2 mobile nve
fix         3 insert nve
run         1 post no
run         0
group nonargon type 1 2 3
unfix       burst_depo
unfix       2
unfix       3
if "$(count(insert)) == 0" then "variable n_burst_fail equal ${n_burst_fail}+1"
variable    n_burst_sim equal ${n_burst_sim}+1
label       burst_next_1_0
next        burst_k1_0
jump        SELF burst_dep_1_0
region      bzone1_0 delete
# --- Burst chunk 1/4: dynamics, then thermalize ---
variable    burst_nclusts0 equal $(c_nclusts)
group       insert clear
group       mobile subtract all anchor
fix         2 mobile nve
fix         ats_burst all dt/reset 1 NULL 1.00 0.01 units box
variable    t0_burst equal $(time)
variable    burst_elapsed equal time-${t0_burst}
fix         burst_thalt all halt 1 v_burst_elapsed > ${phase_1_inter_neutral_time} error continue message yes
run         0
label       burst_inner_1_0
run         500 pre no post no
run         0
if "${one_clust} == 0" then "include sweep.lmp"
if "$(time-v_t0_burst) < ${phase_1_inter_neutral_time}" then "jump SELF burst_inner_1_0"
unfix       burst_thalt
unfix       ats_burst
include     thermalize.lmp
if "${co2_desorb_fraction} > 0" then "include co2_desorption.lmp"
unfix       2

# --- Burst chunk 2/4: 3 atoms (deposit) ---
include     surface_top.lmp
timestep    1e-10
if "$(v_z_surf_top+v_radical_i_above+2.0) > $(zhi)" then "change_box all z delta 0 $(v_z_surf_top+v_radical_i_above+2.0-zhi) units box" "region bbox delete" "region bbox block EDGE EDGE EDGE EDGE EDGE EDGE"
variable    z_ins1_1 equal ${z_surf_top}+${radical_i_above}
region      bzone1_1 block EDGE EDGE EDGE EDGE $(v_z_ins1_1 - 0.1) $(v_z_ins1_1 + 0.1) units box
variable    n_sim_pre1_1 equal ${n_burst_sim}
variable    burst_k1_1 loop 3
label       burst_dep_1_1
variable    burst_ia equal $(3+v_burst_k1_1)
variable    bms_b equal v_c*100000+v_burst_ia+${seed_adjust}*1000000
variable    rad_e_b equal $(v_current_radical_energy)
variable    cos_th_b equal $(cos(v_current_rad_angl*PI/180))
variable    phi_b equal $(v_current_rad_azimuth*PI/180)
variable    sin_th_b equal $(sqrt(1.0-v_cos_th_b*v_cos_th_b))
variable    spd_b equal $(sqrt(2*v_rad_e_b*6.02214129*1.0e+7/v_M_O/6242)/1000)
variable    vx_burst equal $(v_spd_b*v_sin_th_b*cos(v_phi_b))
variable    vy_burst equal $(v_spd_b*v_sin_th_b*sin(v_phi_b))
variable    vz_burst equal $(-v_spd_b*v_cos_th_b)
variable    rad_sim equal 1
print       "${c} ${burst_ia} ${rad_e_b} $(acos(v_cos_th_b)*180/PI) $(v_phi_b*180/PI) ${rad_sim}" append radical_log.txt
group       insert clear
group       mobile subtract all anchor
variable    burst_seed equal floor(random(1,72099+${seed_adjust},${c}*100000+${burst_ia}))
fix         burst_depo insert deposit 1 3 1 ${burst_seed} attempt 5000 vx ${vx_burst} ${vx_burst} vy ${vy_burst} ${vy_burst} vz ${vz_burst} ${vz_burst} region bzone1_1 near 3.5 units box
fix         2 mobile nve
fix         3 insert nve
run         1 post no
run         0
group nonargon type 1 2 3
unfix       burst_depo
unfix       2
unfix       3
if "$(count(insert)) == 0" then "variable n_burst_fail equal ${n_burst_fail}+1"
variable    n_burst_sim equal ${n_burst_sim}+1
label       burst_next_1_1
next        burst_k1_1
jump        SELF burst_dep_1_1
region      bzone1_1 delete
# --- Burst chunk 2/4: dynamics, then thermalize ---
variable    burst_nclusts0 equal $(c_nclusts)
group       insert clear
group       mobile subtract all anchor
fix         2 mobile nve
fix         ats_burst all dt/reset 1 NULL 1.00 0.01 units box
variable    t0_burst equal $(time)
variable    burst_elapsed equal time-${t0_burst}
fix         burst_thalt all halt 1 v_burst_elapsed > ${phase_1_inter_neutral_time} error continue message yes
run         0
label       burst_inner_1_1
run         500 pre no post no
run         0
if "${one_clust} == 0" then "include sweep.lmp"
if "$(time-v_t0_burst) < ${phase_1_inter_neutral_time}" then "jump SELF burst_inner_1_1"
unfix       burst_thalt
unfix       ats_burst
include     thermalize.lmp
if "${co2_desorb_fraction} > 0" then "include co2_desorption.lmp"
unfix       2

# --- Burst chunk 3/4: 3 atoms (deposit) ---
include     surface_top.lmp
timestep    1e-10
if "$(v_z_surf_top+v_radical_i_above+2.0) > $(zhi)" then "change_box all z delta 0 $(v_z_surf_top+v_radical_i_above+2.0-zhi) units box" "region bbox delete" "region bbox block EDGE EDGE EDGE EDGE EDGE EDGE"
variable    z_ins1_2 equal ${z_surf_top}+${radical_i_above}
region      bzone1_2 block EDGE EDGE EDGE EDGE $(v_z_ins1_2 - 0.1) $(v_z_ins1_2 + 0.1) units box
variable    n_sim_pre1_2 equal ${n_burst_sim}
variable    burst_k1_2 loop 3
label       burst_dep_1_2
variable    burst_ia equal $(6+v_burst_k1_2)
variable    bms_b equal v_c*100000+v_burst_ia+${seed_adjust}*1000000
variable    rad_e_b equal $(v_current_radical_energy)
variable    cos_th_b equal $(cos(v_current_rad_angl*PI/180))
variable    phi_b equal $(v_current_rad_azimuth*PI/180)
variable    sin_th_b equal $(sqrt(1.0-v_cos_th_b*v_cos_th_b))
variable    spd_b equal $(sqrt(2*v_rad_e_b*6.02214129*1.0e+7/v_M_O/6242)/1000)
variable    vx_burst equal $(v_spd_b*v_sin_th_b*cos(v_phi_b))
variable    vy_burst equal $(v_spd_b*v_sin_th_b*sin(v_phi_b))
variable    vz_burst equal $(-v_spd_b*v_cos_th_b)
variable    rad_sim equal 1
print       "${c} ${burst_ia} ${rad_e_b} $(acos(v_cos_th_b)*180/PI) $(v_phi_b*180/PI) ${rad_sim}" append radical_log.txt
group       insert clear
group       mobile subtract all anchor
variable    burst_seed equal floor(random(1,72099+${seed_adjust},${c}*100000+${burst_ia}))
fix         burst_depo insert deposit 1 3 1 ${burst_seed} attempt 5000 vx ${vx_burst} ${vx_burst} vy ${vy_burst} ${vy_burst} vz ${vz_burst} ${vz_burst} region bzone1_2 near 3.5 units box
fix         2 mobile nve
fix         3 insert nve
run         1 post no
run         0
group nonargon type 1 2 3
unfix       burst_depo
unfix       2
unfix       3
if "$(count(insert)) == 0" then "variable n_burst_fail equal ${n_burst_fail}+1"
variable    n_burst_sim equal ${n_burst_sim}+1
label       burst_next_1_2
next        burst_k1_2
jump        SELF burst_dep_1_2
region      bzone1_2 delete
# --- Burst chunk 3/4: dynamics, then thermalize ---
variable    burst_nclusts0 equal $(c_nclusts)
group       insert clear
group       mobile subtract all anchor
fix         2 mobile nve
fix         ats_burst all dt/reset 1 NULL 1.00 0.01 units box
variable    t0_burst equal $(time)
variable    burst_elapsed equal time-${t0_burst}
fix         burst_thalt all halt 1 v_burst_elapsed > ${phase_1_inter_neutral_time} error continue message yes
run         0
label       burst_inner_1_2
run         500 pre no post no
run         0
if "${one_clust} == 0" then "include sweep.lmp"
if "$(time-v_t0_burst) < ${phase_1_inter_neutral_time}" then "jump SELF burst_inner_1_2"
unfix       burst_thalt
unfix       ats_burst
include     thermalize.lmp
if "${co2_desorb_fraction} > 0" then "include co2_desorption.lmp"
unfix       2

# --- Burst chunk 4/4: 3 atoms (deposit) ---
include     surface_top.lmp
timestep    1e-10
if "$(v_z_surf_top+v_radical_i_above+2.0) > $(zhi)" then "change_box all z delta 0 $(v_z_surf_top+v_radical_i_above+2.0-zhi) units box" "region bbox delete" "region bbox block EDGE EDGE EDGE EDGE EDGE EDGE"
variable    z_ins1_3 equal ${z_surf_top}+${radical_i_above}
region      bzone1_3 block EDGE EDGE EDGE EDGE $(v_z_ins1_3 - 0.1) $(v_z_ins1_3 + 0.1) units box
variable    n_sim_pre1_3 equal ${n_burst_sim}
variable    burst_k1_3 loop 3
label       burst_dep_1_3
variable    burst_ia equal $(9+v_burst_k1_3)
variable    bms_b equal v_c*100000+v_burst_ia+${seed_adjust}*1000000
variable    rad_e_b equal $(v_current_radical_energy)
variable    cos_th_b equal $(cos(v_current_rad_angl*PI/180))
variable    phi_b equal $(v_current_rad_azimuth*PI/180)
variable    sin_th_b equal $(sqrt(1.0-v_cos_th_b*v_cos_th_b))
variable    spd_b equal $(sqrt(2*v_rad_e_b*6.02214129*1.0e+7/v_M_O/6242)/1000)
variable    vx_burst equal $(v_spd_b*v_sin_th_b*cos(v_phi_b))
variable    vy_burst equal $(v_spd_b*v_sin_th_b*sin(v_phi_b))
variable    vz_burst equal $(-v_spd_b*v_cos_th_b)
variable    rad_sim equal 1
print       "${c} ${burst_ia} ${rad_e_b} $(acos(v_cos_th_b)*180/PI) $(v_phi_b*180/PI) ${rad_sim}" append radical_log.txt
group       insert clear
group       mobile subtract all anchor
variable    burst_seed equal floor(random(1,72099+${seed_adjust},${c}*100000+${burst_ia}))
fix         burst_depo insert deposit 1 3 1 ${burst_seed} attempt 5000 vx ${vx_burst} ${vx_burst} vy ${vy_burst} ${vy_burst} vz ${vz_burst} ${vz_burst} region bzone1_3 near 3.5 units box
fix         2 mobile nve
fix         3 insert nve
run         1 post no
run         0
group nonargon type 1 2 3
unfix       burst_depo
unfix       2
unfix       3
if "$(count(insert)) == 0" then "variable n_burst_fail equal ${n_burst_fail}+1"
variable    n_burst_sim equal ${n_burst_sim}+1
label       burst_next_1_3
next        burst_k1_3
jump        SELF burst_dep_1_3
region      bzone1_3 delete
# --- Burst chunk 4/4: dynamics, then thermalize ---
variable    burst_nclusts0 equal $(c_nclusts)
group       insert clear
group       mobile subtract all anchor
fix         2 mobile nve
fix         ats_burst all dt/reset 1 NULL 1.00 0.01 units box
variable    t0_burst equal $(time)
variable    burst_elapsed equal time-${t0_burst}
fix         burst_thalt all halt 1 v_burst_elapsed > ${phase_1_inter_neutral_time} error continue message yes
run         0
label       burst_inner_1_3
run         500 pre no post no
run         0
if "${one_clust} == 0" then "include sweep.lmp"
if "$(time-v_t0_burst) < ${phase_1_inter_neutral_time}" then "jump SELF burst_inner_1_3"
unfix       burst_thalt
unfix       ats_burst
include     thermalize.lmp
if "${co2_desorb_fraction} > 0" then "include co2_desorption.lmp"
unfix       2

# Remove detached atoms/clusters left above the surface after the burst
variable    sweep_any_vz delete
variable    sweep_any_vz index 1
include     sweep.lmp
variable    sweep_any_vz delete
variable    sweep_any_vz index 0
group       carbon type 1
group       hydrogen type 2
group       oxygen type 3
variable    ncarbon_b equal count(carbon)
variable    nhydrogen_b equal count(hydrogen)
variable    noxygen_b equal count(oxygen)
if "${n_burst_fail} > 0" then "print 'c=${c} placed=$(v_n_burst_sim-v_n_burst_fail) expected=${n_burst_sim} shortfall=${n_burst_fail}' append BURST_INCOMPLETE"
print       "Burst complete (${c} impacts done)"
print       "${c} 1 ${ncarbon_b} ${nhydrogen_b} ${noxygen_b}" append ncarbon.txt
write_data  impact_snaps/${c}_1.data nofix nocoeff
variable    cn_start equal 0
jump        SELF skip_chem

label       burst_dispatch_done
# ─────────────────────────────────────────────────────────────────────────────

# Stochastic floor/ceil: draw floor(R) or ceil(R) radicals so long-run avg = R
variable    flux_lo equal floor(v_current_flux_ratio)
variable    flux_hi equal ceil(v_current_flux_ratio)
variable    p_hi equal v_current_flux_ratio-v_flux_lo
variable    r_fr equal $(random(0,1,v_c+80000+v_seed_adjust))
variable    target_flux equal ${flux_lo}
if "${p_hi} > 0 && ${r_fr} < ${p_hi}" then "variable target_flux equal ${flux_hi}"

if "${cn_start} > 0 && ${cn_start} < ${target_flux}" then &
"variable neutral_lp loop $(v_target_flux-v_cn_start)" &
elif "${cn_start} == ${target_flux}" &
"jump SELF skip_chem" &
else &
"variable neutral_lp loop ${target_flux}"

label       neutral_loop
# Refresh bbox: runs shrink-wrap zhi (boundary p p m); a stale region fails fix deposit
region bbox delete
region bbox block EDGE EDGE EDGE EDGE EDGE EDGE
variable    cn equal ${cn}+1
variable    deposeed equal floor(random(1,72099+${seed_adjust},${cn}))
group       insert clear
group       mobile subtract all anchor
group nonargon type 1 2 3

# Radical velocity (fixed-energy, per-phase angle)
variable    vel_chem equal sqrt(2*${current_radical_energy}*6.02214129*1.0e+7/${M_O}/6242)/1000
variable    velx_chem equal sin(${current_rad_angl}*PI/180)*cos(${current_rad_azimuth}*PI/180)*${vel_chem}
variable    vely_chem equal sin(${current_rad_angl}*PI/180)*sin(${current_rad_azimuth}*PI/180)*${vel_chem}
variable    velz_chem equal cos(${current_rad_angl}*PI/180)*${vel_chem}

# Deposit O• radical (always type 3)
fix         depo insert deposit 1 3 1 ${deposeed} global ${radical_i_above} ${radical_i_above} vx ${velx_chem} ${velx_chem} vy ${vely_chem} ${vely_chem} vz -${velz_chem} -${velz_chem} region bbox units box
fix         2 mobile nve
fix         3 insert nve

timestep    1e-10
run         1 post no
group nonargon type 1 2 3
run         0
variable    starting_nclusts equal $(c_nclusts)
variable    t0 equal $(time)
variable    time_elapsed equal time-${t0}
fix         thalt all halt 1 v_time_elapsed > ${current_inter_neutral_time} error continue message yes

# ======================== Neutral inner loop ========================
label       continue_n_impact
run         500 pre no post no
run         0
if "$(c_nclusts) > ${starting_nclusts}" then &
"variable event_count equal ${event_count}+1" &
"variable starting_nclusts equal $(c_nclusts)"
if "${one_clust} == 0" then "include sweep.lmp"
if "$(time-v_t0) < ${current_inter_neutral_time}" then "jump SELF continue_n_impact"

group       carbon type 1
group       hydrogen type 2
group       oxygen type 3
variable    ncarbon equal count(carbon)
variable    nhydrogen equal count(hydrogen)
variable    noxygen equal count(oxygen)

print       "Neutral run ${cn} complete"
print       "C_COUNT_neutral: ${ncarbon}"
print       "${c} ${cn} ${ncarbon} ${nhydrogen} ${noxygen}" append ncarbon.txt
write_data  impact_snaps/${c}_${cn}.data nofix nocoeff

unfix       thalt
unfix       depo
unfix       2
unfix       3
# ======================== End neutral inner loop ========================
next        neutral_lp
jump        SELF neutral_loop

label       skip_chem
variable    cn_start equal 0
variable    cn equal 0
# ========================= End neutral deposition loop =========================

# Final thermalize before ion impact
if "${co2_desorb_fraction} > 0" then "include co2_desorption.lmp"
include     thermalize.lmp
# Refresh bbox: thermalize may shrink zhi; a stale region fails fix deposit
region bbox delete
region bbox block EDGE EDGE EDGE EDGE EDGE EDGE

# Increment ion impact counter
variable    c equal ${c}+1
variable    deposeed equal floor(random(1,72099+${seed_adjust},${c}))


# Deposit ion (O2 via molecule file, all others as single atom)
if "${current_use_molecule} == 1" then &
"fix depo insert deposit 1 0 1 ${deposeed} global ${ion_i_above} ${ion_i_above} vx ${velx_ion} ${velx_ion} vy ${vely_ion} ${vely_ion} vz -${velz_ion} -${velz_ion} region bbox units box mol O2" &
else &
"fix depo insert deposit 1 ${current_ion_type} 1 ${deposeed} global ${ion_i_above} ${ion_i_above} vx ${velx_ion} ${velx_ion} vy ${vely_ion} ${vely_ion} vz -${velz_ion} -${velz_ion} region bbox units box"
fix         2 mobile nve
fix         3 insert nve

timestep    1e-10
run         1 post no
group nonargon type 1 2 3
run         0
variable    starting_nclusts equal $(c_nclusts)
thermo      100
variable    t0 equal $(time)
variable    time_elapsed equal time-${t0}
fix         thalt all halt 1 v_time_elapsed > ${impact_time} error continue message yes
run         0
variable    n_channelled equal 0

# =========================== Ion inner loop ===========================
label       continue_impact
run         1000000000 pre no post no
run         0
variable    n_channelled equal 0
if "$(c_nclusts) > ${starting_nclusts}" then &
"variable event_count equal ${event_count}+1" &
"variable starting_nclusts equal $(c_nclusts)"
if "${one_clust} == 0" then &
"include sweep.lmp" &
"region channelled block INF INF INF INF INF ${bottom} units lattice" &
"group channelled_group region channelled" &
"variable n_channelled equal count(channelled_group)" &
"region channelled delete"

if "${n_channelled} > 0" then &
"variable event_count equal ${event_count}+1" &
"delete_atoms group channelled_group" &
"run 0" &
"group channelled_group delete" &
"variable n_channelled equal 0"

if "$(time-v_t0) < ${impact_time}" then "jump SELF continue_impact"
unfix       thalt
# =========================== End ion inner loop ===========================

unfix       depo
unfix       ats

if "${current_needs_removal} == 1" then &
"group       ArRemove type 4" &
"delete_atoms group ArRemove" &
"group       ArRemove delete"

if "${one_clust} == 0" then "include sweep.lmp"

# Thermalize
if "${co2_desorb_fraction} > 0" then "include co2_desorption.lmp"
include     thermalize.lmp

unfix       2
unfix       3

# Replenish carbon if etched below baseline
group       carbon type 1
group       hydrogen type 2
group       oxygen type 3
variable    ncarbon equal count(carbon)
variable    nhydrogen equal count(hydrogen)
variable    noxygen equal count(oxygen)
label       addfix
if "${ncarbon}<${n_lat_0}" then &
"include addfix.lmp" &
"fix 2 mobile nve" &
"include thermalize.lmp" &
"unfix 2"
if "${ncarbon}<${n_lat_0}" then "jump SELF addfix"

print       "Run ${c} complete"
print       "C_COUNT: ${ncarbon}"
print       "${c} 0 ${ncarbon} ${nhydrogen} ${noxygen}" append ncarbon.txt

write_data  impact_snaps/${c}_0.data nofix nocoeff
if '$(v_c%v_ML) == 0' then "write_dump all custom ML_impacts.dump id type x y z vx vy vz q modify sort id append yes"

# ========================= End Per-Impact Outer Loop =========================
next        a
jump        SELF loop
