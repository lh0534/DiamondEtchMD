# Delete atoms that left through the bottom of the slab (> 2 Å below the fixed
# anchor atoms; works in every mode, unlike the lattice-unit bottom).  The z
# boundary is shrink-wrapped, so an escaped atom drags zlo down with it (to
# -2000 Å in one case), which breaks thermalize.lmp and restarts; pull zlo back.
variable    z_escape equal -1e19   # disabled: empty region (INF = -1e20)
if "$(count(anchor)) > 0" then "variable z_escape equal $(bound(anchor,zmin)-2.0)"
region      escaped block INF INF INF INF INF ${z_escape} units box
group       escaped region escaped
variable    n_escaped equal count(escaped)
if "${n_escaped} > 0" then &
"print '${c} ${cn}: deleted ${n_escaped} atom(s) below the slab bottom' append ESCAPED_ATOMS" &
"delete_atoms group escaped" &
"change_box      all z final $(bound(all,zmin)-3.0) $(zhi) units box" &
"region          bbox delete" &
"region          bbox block EDGE EDGE EDGE EDGE EDGE EDGE"
group       escaped delete
region      escaped delete
variable    n_escaped delete
variable    z_escape delete

# sweep_any_vz = 1 (set by burst cleanup) also removes detached clusters above the
# surface that are not moving up; an index variable, so 0 unless already set.
variable    sweep_any_vz index 0

# Identify and remove ejected clusters.
# A cluster is an etch product only if its CoM z is above all confirmed-surface
# atoms (anchor cluster + prior non-leaving clusters) and it has a positive z velocity.
# Using the `checked` group rather than `all - candidate` avoids a deadlock where
# two simultaneously ejected clusters each prevent the other from being swept.
group       unchecked union all all
compute     surf_clust_num anchor reduce min c_clusts
compute     max_unchecked_clust_num unchecked reduce max c_clusts

thermo_style custom c_max_unchecked_clust_num c_surf_clust_num
run 0 post no

variable    in_surf_clust atom "c_clusts == c_surf_clust_num"
variable    in_small_clust atom "c_clusts == c_max_unchecked_clust_num"
group       surf variable in_surf_clust
group       checked intersect all surf
group       unchecked clear
group       unchecked subtract all checked

thermo_style custom c_max_unchecked_clust_num
label       resweep
run 0 post no

group       small_clust variable in_small_clust

# max z of confirmed-surface atoms (surface cluster + prior non-leaving clusters).
# Using `checked` rather than `all - small_clust` prevents simultaneously ejected
# clusters from raising each other's ejection threshold and deadlocking.
compute     top_rest checked reduce max z
thermo_style custom c_max_unchecked_clust_num c_top_rest
run 0 post no

variable    top_thresh equal c_top_rest
if "${above_surf_eject} == 0" then "variable top_thresh equal -1e20"

group       carbon type 1
group       hydrogen type 2
group       oxygen type 3
group       argon type 4
group       clust_carbon intersect carbon small_clust
group       clust_hydrogen intersect hydrogen small_clust
group       clust_oxygen intersect oxygen small_clust
group       clust_argon intersect argon small_clust

# Eject only if CoM is above ALL other atoms and moving upward with meaningful velocity.
# Threshold 0.01 Å/fs (~1000 m/s) is ~10x above the COM thermal velocity of a 50-atom
# cluster at 300 K, preventing thermally-fluctuating surface fragments from being swept.
if "$(xcm(small_clust,z) > v_top_thresh) && ($(vcm(small_clust,z) > 0) || ${sweep_any_vz}) && $(count(surf) > 0) && $(count(clust_carbon)+count(clust_hydrogen)+count(clust_oxygen)+count(clust_argon)) > 0" then &
"""if "$(count(clust_carbon)) > 0" then "variable n_c_ejected_total equal 1" """ &
"print '${c} ${cn} $(count(clust_carbon)) $(count(clust_hydrogen)) $(count(clust_oxygen)) $(count(clust_argon)) $(vcm(small_clust,z))' append etch_products.txt" &
"delete_atoms group small_clust" &
"change_box      all z final $(zlo) $(zhi) units box" &
"region          bbox delete" &
"region          bbox block EDGE EDGE EDGE EDGE EDGE EDGE" &
else "group checked union checked small_clust"

variable    top_thresh delete
uncompute top_rest
group small_clust clear
group clust_carbon clear
group clust_hydrogen clear
group clust_oxygen clear
group clust_argon clear
group unchecked clear
group unchecked subtract all checked
# reset thermo_style before next iteration so c_top_rest (now uncomputed) is not referenced
thermo_style custom c_max_unchecked_clust_num
if "$(count(unchecked)) > 0" then "jump SELF resweep"

uncompute surf_clust_num
uncompute max_unchecked_clust_num
group surf delete
group unchecked delete
group checked delete
group small_clust delete
group clust_carbon delete
group clust_hydrogen delete
group clust_oxygen delete
group clust_argon delete

# reset thermo_style and run 0 to reinitialize everything
thermo_style    custom step time v_ninject temp c_ike dt ecouple v_ate v_one_clust c_nclusts
thermo_modify   temp mtemp
thermo_modify   lost warn flush yes
run 0 post no
