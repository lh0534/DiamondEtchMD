# --- Burst chunk 1/2: 10 atoms (deposit phase) ---
if "$(bound(all,zmax)+v_radical_i_above+2.0) > $(zhi)" then "change_box all z delta 0 $(bound(all,zmax)+v_radical_i_above+2.0-zhi) units box" "region bbox delete" "region bbox block EDGE EDGE EDGE EDGE EDGE EDGE" 
variable    z_ins0 equal bound(all,zmax)+${radical_i_above}
region      bzone0 block EDGE EDGE EDGE EDGE $(v_z_ins0 - 0.1) $(v_z_ins0 + 0.1) units box
variable    n_sim_pre0 equal ${n_burst_sim}
variable    burst_k0 loop 10
label       burst_dep_0
variable    burst_ia equal $(0+v_burst_k0)
variable    bms_b equal v_c*100000+v_burst_ia+${seed_adjust}*1000000
variable    u1f_b equal $(random(1e-10,1.0,v_bms_b+9))
variable    u2f_b equal $(random(1e-10,1.0,v_bms_b+10))
variable    rad_e_b equal $(-v_kT_rad*ln(v_u1f_b*v_u2f_b))
variable    u_th_b equal $(random(0.0,1.0,v_bms_b+7))
variable    u_ph_b equal $(random(0.0,1.0,v_bms_b+8))
variable    cos_th_b equal $(sqrt(v_u_th_b))
variable    phi_b equal $(2*PI*v_u_ph_b)
variable    sin_th_b equal $(sqrt(1.0-v_cos_th_b*v_cos_th_b))
variable    spd_b equal $(sqrt(2*v_rad_e_b*6.02214129*1.0e+7/v_M_O/6242)/1000)
variable    vx_burst equal $(v_spd_b*v_sin_th_b*cos(v_phi_b))
variable    vy_burst equal $(v_spd_b*v_sin_th_b*sin(v_phi_b))
variable    vz_burst equal $(-v_spd_b*v_cos_th_b)
variable    rad_sim equal 1
if "$(v_rad_e_b) < ${radical_e_thresh}" then "variable rad_sim equal 0"
print       "${c} ${burst_ia} ${rad_e_b} $(acos(v_cos_th_b)*180/PI) $(v_phi_b*180/PI) ${rad_sim}" append radical_log.txt
if "${rad_sim} == 0" then "jump SELF burst_next_0"
group       insert clear
group       mobile subtract all anchor
variable    burst_seed equal floor(random(1,72099+${seed_adjust},${c}*100000+${burst_ia}))
fix         burst_depo insert deposit 1 3 1 ${burst_seed} attempt 5000 vx ${vx_burst} ${vx_burst} vy ${vy_burst} ${vy_burst} vz ${vz_burst} ${vz_burst} region bzone0 near 3.5 units box
fix         2 mobile nve
fix         3 insert nve
run         1 post no
run         0
unfix       burst_depo
unfix       2
unfix       3
if "$(count(insert)) == 0" then "variable n_burst_fail equal ${n_burst_fail}+1"
variable    n_burst_sim equal ${n_burst_sim}+1
label       burst_next_0
next        burst_k0
jump        SELF burst_dep_0
region      bzone0 delete
variable    z_ins0 delete
if "${n_burst_sim} == ${n_sim_pre0}" then "jump SELF burst_chunk_done_0"

label       burst_chunk_done_0
