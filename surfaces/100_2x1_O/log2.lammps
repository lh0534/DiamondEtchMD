package kokkos
# head.lmp — generated by DiamondEtchMD
# orientation=100  species=O  0.5eV  300.0K  angle=0.0deg
package kokkos neigh/qeq full neigh half newton on
units		real
include     config.lmp
# DiamondEtchMD generated config
# orientation=100  surface=2x1_O
# species=O  energy=0.5eV  angle=0.0deg  T=300.0K

variable    ML equal 81            # atoms per monolayer
variable    end_fluence equal 50   # in ML

variable    energ equal 0.5     # incident energy per atom (eV)
variable    angl equal 0.0       # incident particle angle (deg from normal)
variable    T equal 300.0    # substrate temperature (K)
variable    pot string REAX

variable    use_starting_data_file equal false
variable    starting_data_file string data.truncated

if "${pot} == REAX" then "variable    lat_a file lat_a.txt"
variable    lat_a file lat_a.txt

variable    x equal 9
variable    y equal 9
variable    lat_top equal 3
variable    z equal ${lat_top}+5
variable    z equal 3+5

variable    reconstruct equal true
variable    O_terminate equal true
variable    O_ether_terminate equal false

variable    i_above equal 6.0    # Å above surface to inject particle
variable    impact_time equal 2000.0
variable    thermalization_time equal 500.0

variable    M_C equal 12.011
variable    M_H equal 1.00784
variable    M_O equal 16.0
variable    M_Ar equal 39.948
variable    M_incident equal ${M_O}
variable    M_incident equal 16
variable    incident_type_index equal 3  # O

variable    seed_adjust equal 0
variable    simdepo equal 1
if "${pot} == COMB3" then "atom_style charge" elif "${pot} == REAX" "atom_style charge" else "atom_style atomic"
atom_style charge

boundary	p p m

# create_box with 4 types then merge data file so type 4 (Ar) is available
region      dummy_region block 0 1 0 1 0 1
create_box  4 dummy_region
Created orthogonal box = (0 0 0) to (1 1 1)
  1 by 1 by 1 MPI processor grid
read_data   ${data_file} add merge
read_data   data_files/0.data add merge
Reading data file ...
  orthogonal box = (0 0 -2.228367) to (22.689985 22.689985 28.523097)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  1296 atoms
  reading velocities ...
  1296 velocities
  read_data CPU = 0.066 seconds

variable 	lp equal $(v_end_fluence*v_ML)-${n_complete} # impacts left
variable 	lp equal 4050-${n_complete} 
variable 	lp equal 4050-0 
variable    a loop ${lp}
variable    a loop 4050
variable    bottom equal $(zlo/(v_lat_a))
variable    bottom equal -0.625
print       'BOTTOM ${bottom}'
BOTTOM -0.625
print       'N_LAT_0 ${n_lat_0}'
N_LAT_0 1296

# Regions — lattice must match make_surf.lmp for this orientation
lattice    diamond ${lat_a} orient z 0 0 1 orient x 1 1 0 orient y -1 1 0 spacing $(1/sqrt(2)) $(1/sqrt(2)) 1 origin 0 0 0
lattice    diamond 3.5653871687699 orient z 0 0 1 orient x 1 1 0 orient y -1 1 0 spacing $(1/sqrt(2)) $(1/sqrt(2)) 1 origin 0 0 0
lattice    diamond 3.5653871687699 orient z 0 0 1 orient x 1 1 0 orient y -1 1 0 spacing 0.70710678118654746172 $(1/sqrt(2)) 1 origin 0 0 0
lattice    diamond 3.5653871687699 orient z 0 0 1 orient x 1 1 0 orient y -1 1 0 spacing 0.70710678118654746172 0.70710678118654746172 1 origin 0 0 0
Lattice spacing in x,y,z = 2.5211094 2.5211094 3.5653872
region          bbox block EDGE EDGE EDGE EDGE EDGE EDGE
variable        sublat equal ${bottom}+1/2
variable        sublat equal -0.625+1/2
region          anchor block INF INF INF INF ${bottom} ${sublat} units lattice
region          anchor block INF INF INF INF -0.625 ${sublat} units lattice
region          anchor block INF INF INF INF -0.625 -0.125 units lattice

# Groups
group 	anchor region anchor
162 atoms in group anchor
group	insert empty
0 atoms in group insert
group 	mobile subtract all anchor
1134 atoms in group mobile
group   carbon type 1
1215 atoms in group carbon

# Particle masses (4 types: C, H, O, Ar)
mass        1 ${M_C}
mass        1 12.011
mass        2 ${M_H}
mass        2 1.00784
mass        3 ${M_O}
mass        3 16
mass        4 ${M_Ar}
mass        4 39.948

# Potential
if "${pot} == REAX" then "pair_style reaxff NULL mincap 200 safezone 1.5" "pair_coeff * * ffield.reax C H O NULL" "fix reax_qeq all qeq/reaxff 1 0.0 6.0 1e-6 reaxff"
pair_style reaxff NULL mincap 200 safezone 1.5
pair_coeff * * ffield.reax C H O NULL
Reading potential file ffield.reax with DATE: 2011-02-18
WARNING: Changed valency_val to valency_boc for X (src/REAXFF/reaxff_ffield.cpp:296)
fix reax_qeq all qeq/reaxff 1 0.0 6.0 1e-6 reaxff

# Pre-run counters
variable c equal ${n_complete}
variable c equal 0
variable event_count equal ${n_events}
variable event_count equal 0

# Atom counts
variable	nfixed   equal count(anchor)
variable	nmobile  equal count(mobile)
variable 	ninject  equal count(insert)

# Incident particle velocity components
variable 	vel equal sqrt(2*${energ}*6.02214129*1.0e+7/${M_incident}/6242)/1000
variable 	vel equal sqrt(2*0.5*6.02214129*1.0e+7/${M_incident}/6242)/1000
variable 	vel equal sqrt(2*0.5*6.02214129*1.0e+7/16/6242)/1000
variable 	velz equal cos(${angl}*PI/180)*${vel}
variable 	velz equal cos(0*PI/180)*${vel}
variable 	velz equal cos(0*PI/180)*0.0245557722545495
variable 	vely equal sin(${angl}*PI/180)*${vel}
variable 	vely equal sin(0*PI/180)*${vel}
variable 	vely equal sin(0*PI/180)*0.0245557722545495

# Energy conservation check
compute     ake all ke
compute     ape all pe
compute     ike insert ke
variable    ate equal c_ake+c_ape+ecouple

# Clustering
variable	checkevery equal 1000
compute	    clusts all cluster/atom 3.0
compute	    clust_min all reduce min c_clusts
compute	    clust_max all reduce max c_clusts
variable    one_clust equal "c_clust_min == c_clust_max"
fix		    stopclust all halt ${checkevery} v_one_clust == 0 error continue message yes
fix		    stopclust all halt 1000 v_one_clust == 0 error continue message yes

# Carbon cluster event tracking
compute     cclusts carbon cluster/atom 1.8
compute     cc1 carbon chunk/atom c_cclusts compress yes
compute     nclusts carbon reduce max c_cc1

# Thermo
thermo_style    custom step time v_ninject temp c_ike dt ecouple v_ate v_one_clust c_nclusts
compute     	mtemp mobile temp
compute_modify  mtemp dynamic/dof yes
thermo_modify   temp mtemp
WARNING: Temperature for thermo pressure is not for group all (src/thermo.cpp:520)
thermo_modify   lost warn flush yes

print "${c}" file begin.txt
0

# ========================= Begin Per-Impact Outer Loop =========================
label		loop

dump current_dump all custom 100 dumps/event_dump_${event_count}.dump id type x y z vx vy vz fx fy fz q
dump current_dump all custom 100 dumps/event_dump_0.dump id type x y z vx vy vz fx fy fz q

group       insert clear
group 	    mobile subtract all anchor
1134 atoms in group mobile

variable    c equal ${c}+1
variable    c equal 0+1
variable    deposeed equal floor(random(1,72099+${seed_adjust},${c}))
variable    deposeed equal floor(random(1,72099+0,${c}))
variable    deposeed equal floor(random(1,72099+0,1))
fix     depo insert deposit 1 ${incident_type_index} 10000000000 ${deposeed} global ${i_above} ${i_above} vx 0.0 0.0 vy ${vely} ${vely} vz -${velz} -${velz} region bbox units box
fix     depo insert deposit 1 3 10000000000 ${deposeed} global ${i_above} ${i_above} vx 0.0 0.0 vy ${vely} ${vely} vz -${velz} -${velz} region bbox units box
fix     depo insert deposit 1 3 10000000000 5779 global ${i_above} ${i_above} vx 0.0 0.0 vy ${vely} ${vely} vz -${velz} -${velz} region bbox units box
fix     depo insert deposit 1 3 10000000000 5779 global 6 ${i_above} vx 0.0 0.0 vy ${vely} ${vely} vz -${velz} -${velz} region bbox units box
fix     depo insert deposit 1 3 10000000000 5779 global 6 6 vx 0.0 0.0 vy ${vely} ${vely} vz -${velz} -${velz} region bbox units box
fix     depo insert deposit 1 3 10000000000 5779 global 6 6 vx 0.0 0.0 vy 0 ${vely} vz -${velz} -${velz} region bbox units box
fix     depo insert deposit 1 3 10000000000 5779 global 6 6 vx 0.0 0.0 vy 0 0 vz -${velz} -${velz} region bbox units box
fix     depo insert deposit 1 3 10000000000 5779 global 6 6 vx 0.0 0.0 vy 0 0 vz -0.0245557722545495 -${velz} region bbox units box
fix     depo insert deposit 1 3 10000000000 5779 global 6 6 vx 0.0 0.0 vy 0 0 vz -0.0245557722545495 -0.0245557722545495 region bbox units box

fix     2 mobile nve
fix     3 insert nve

# Run 1 fs timestep to place incident particle
timestep 1e-10
run 1 post no
