variable term_top equal ${lat_top}+1/8
variable term_top equal 5+1/8
variable term_bottom equal ${lat_top}
variable term_bottom equal 5
region term block 0 ${x} 0 ${y} ${term_bottom} ${term_top} units lattice
region term block 0 4 0 ${y} ${term_bottom} ${term_top} units lattice
region term block 0 4 0 6 ${term_bottom} ${term_top} units lattice
region term block 0 4 0 6 5 ${term_top} units lattice
region term block 0 4 0 6 5 5.125 units lattice
create_atoms 3 region term
