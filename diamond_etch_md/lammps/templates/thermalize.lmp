variable    log_file index log.lammps # sets log file to default if not already set in command line

log therm.log # don't output all this thermostat setting to normal log. too much info

timestep 	0.25

# Thermostatted carbon (th_c).  thermostat_slab_only = 1: only carbon bonded to the
# slab (the anchor's cluster at cleanup_rc), so molecules not bonded to it (products
# on their way out, physisorbed CO2) keep their velocities and cannot stretch the
# slabs below.  0: all carbon.
group       th_c union carbon
if "${thermostat_slab_only} == 0" then "jump SELF th_group_done"
compute     th_cl all cluster/atom ${cleanup_rc}
compute     th_id anchor reduce min c_th_cl
thermo_style custom step c_th_id
run 0 post no
variable    th_in atom "c_th_cl == c_th_id"
group       th_slab variable th_in
group       th_c clear
group       th_c intersect carbon th_slab
group       th_slab delete
variable    th_in delete
uncompute   th_id
uncompute   th_cl
thermo_style    custom step time v_ninject temp c_ike dt ecouple v_ate v_one_clust c_nclusts
thermo_modify   temp mtemp
thermo_modify   lost warn flush yes
label       th_group_done

label setuploop
# Slabs span the thermostatted carbon, not the box: zlo can run far below the atoms (an atom
# escaping downward drags the shrink-wrapped boundary with it), and the old
# bottom*lat_a/sqrt(2) start drifted above the true bottom as the box grew.
variable dz equal ceil(($(bound(th_c,zmax))-$(bound(th_c,zmin)))/16) #16 groups max to prevent going over 36 total
if "${dz}<5" then "variable dz equal 5" # minimum lat_a
variable zbottom equal $(floor(bound(th_c,zmin)))
variable zbottom0 equal $(v_zbottom)
# =============================== begin thermostat setting loop ==========
label set_loop_start 
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
# set thermostats
variable ztop equal ${zbottom}+${dz}
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
group temp_rgn region r${zname}
group temp_c intersect temp_rgn th_c
group g${zname} subtract temp_c anchor
group temp_c delete
group temp_rgn delete
region r${zname} delete
variable nregion equal count(g${zname})
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then & 
"fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" &
"variable zbottom equal ${ztop}" &
"jump SELF set_loop_start"
# note thermostat damping is 250x the timestep, 10% of the thermostat time
# ================================= end thermostat setting loop ==========

# unset empty group and region
variable zbottom_final equal ${zbottom}
group g${zname} delete

# run thermostats
log ${log_file} append # ok log this part

thermo      $(floor(50 / dt))
variable	end_step equal $(step+ceil(v_thermalization_time/dt)) # how long to run for

label		continue_thermo # to continue if a cluster halt stops it
run         ${end_step} upto
if "$(step) < ${end_step}" then "jump SELF continue_thermo" # if interrupted, keep going

log therm.log append # again don't log this normally

variable zbottom equal ${zbottom0}
# no thermostat was set if the first slab had no mobile carbon
if "${zbottom_final} == ${zbottom0}" then "jump SELF unset_loop_done"
# =============================== begin thermostat UNsetting loop ========
label unset_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
unfix t${zname}
group g${zname} delete
variable zbottom equal ${zbottom}+${dz}
if "${zbottom}!=${zbottom_final}" then "jump SELF unset_loop_start"
label unset_loop_done
group th_c delete
# ================================= end UNthermostat setting loop ========
log ${log_file} append 

if "${one_clust} == 0" then "include sweep.lmp" # check if there's a cluster, check if it should be removed
