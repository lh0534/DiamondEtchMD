# head.lmp — generated by DiamondEtchMD (cycling mode)
# orientation=100  phases: Ar@30.0eV×5ML → O2@20.0eV×5ML+O•R10
# 10 cycle(s)  T=300.0K  angle=0.0deg
package     kokkos neigh/qeq full neigh half newton on
units       real
include     config.lmp
if "${pot} == COMB3" then &
"atom_style charge" &
elif "${pot} == REAX" &
"atom_style charge" &
else &
"atom_style atomic"

boundary    p p m

region      dummy_region block 0 1 0 1 0 1
create_box  4 dummy_region
read_data   ${data_file} add merge

# Phase boundary variables (cumulative impacts per cycle)
variable    phase_0_end equal $(v_ML*v_phase_0_ml)
variable    phase_1_end equal $(v_phase_0_end+v_ML*v_phase_1_ml)
variable    impacts_per_cycle equal ${phase_1_end}

variable    lp equal $(v_end_fluence*v_ML)-${n_complete} # impacts left
variable    a loop ${lp}
variable    bottom equal $(zlo/(v_lat_a))
print       'BOTTOM ${bottom}'
print       'N_LAT_0 ${n_lat_0}'

# Regions
lattice    diamond ${lat_a} orient z 0 0 1 orient x 1 1 0 orient y -1 1 0 spacing $(1/sqrt(2)) $(1/sqrt(2)) 1 origin 0 0 0
region      bbox block EDGE EDGE EDGE EDGE EDGE EDGE
variable    sublat equal ${bottom}+1/2
region      anchor block INF INF INF INF ${bottom} ${sublat} units lattice

# Groups
group       anchor region anchor
group       insert empty
group       mobile subtract all anchor
group       carbon type 1

# Masses
mass        1 ${M_C}
mass        2 ${M_H}
mass        3 ${M_O}
mass        4 ${M_Ar}

# Potential
if "${pot} == REAX" then &
"pair_style  hybrid reaxff NULL mincap 200 safezone 1.5 zbl 5.0 6.0" &
"pair_coeff * * reaxff ffield.reax C H O NULL" &
"pair_coeff 1 4 zbl 6.0 18.0" &
"pair_coeff 2 4 zbl 1.0 18.0" &
"pair_coeff 3 4 zbl 8.0 18.0" &
"pair_coeff 4 4 zbl 18.0 18.0" &
"group nonargon type 1 2 3" &
"fix reax_qeq nonargon qeq/reaxff 1 0.0 6.0 1e-6 reaxff"

# Restart state
variable    c equal ${n_complete}
variable    cn_start equal ${neut_complete}
variable    cn equal 0
variable    event_count equal ${n_events}

# Atom count diagnostics
variable    nfixed  equal count(anchor)
variable    nmobile equal count(mobile)
variable    ninject equal count(insert)

# Energy conservation check
compute     ake all ke
compute     ape all pe
compute     ike insert ke
variable    ate equal c_ake+c_ape+ecouple

# Cluster detection
variable    checkevery equal 1000
compute     clusts all cluster/atom 3.0
compute     clust_min all reduce min c_clusts
compute     clust_max all reduce max c_clusts
variable    one_clust equal "c_clust_min == c_clust_max"
fix         stopclust all halt ${checkevery} v_one_clust == 0 error continue message yes

# Carbon cluster event tracking
compute     cclusts carbon cluster/atom 1.8
compute     cc1 carbon chunk/atom c_cclusts compress yes
compute     nclusts carbon reduce max c_cc1

# Thermo
thermo_style    custom step time v_ninject temp c_ike dt ecouple v_ate v_one_clust c_nclusts
compute     mtemp mobile temp
compute_modify  mtemp dynamic/dof yes
thermo_modify   temp mtemp
thermo_modify   lost warn flush yes

print       "${c}" file begin.txt
molecule    O2 O2.molecule

# ========================= Begin Per-Impact Outer Loop =========================
label       loop
group nonargon type 1 2 3
if "${cn_start} > 0" then "variable cn equal ${cn_start}" else "variable cn equal 0"

# Compute position within current cycle
variable    cycle_idx equal floor(v_c/v_impacts_per_cycle)
variable    idx_in_cycle equal $(v_c-v_cycle_idx*v_impacts_per_cycle)

# Phase selection (default: phase 1 = O2)
variable current_ion_type equal 3
variable current_use_molecule equal 1
variable current_ion_energy equal ${phase_1_energy}
variable current_M_ion equal ${M_O}
variable current_flux_ratio equal ${phase_1_flux_ratio}
variable current_radical_energy equal ${phase_1_radical_energy}
variable current_needs_removal equal 0

if "${idx_in_cycle} < ${phase_0_end}" then &
"variable current_ion_type equal 4" &
"variable current_use_molecule equal 0" &
"variable current_ion_energy equal ${phase_0_energy}" &
"variable current_M_ion equal ${M_Ar}" &
"variable current_flux_ratio equal ${phase_0_flux_ratio}" &
"variable current_radical_energy equal ${phase_0_radical_energy}" &
"variable current_needs_removal equal 1"

# Ion and radical velocities for current phase
variable    vel_ion equal sqrt(2*${current_ion_energy}*6.02214129*1.0e+7/${current_M_ion}/6242)/1000
variable    velz_ion equal cos(${angl}*PI/180)*${vel_ion}
variable    vely_ion equal sin(${angl}*PI/180)*${vel_ion}
variable    vel_chem equal sqrt(2*${current_radical_energy}*6.02214129*1.0e+7/${M_O}/6242)/1000
variable    velz_chem equal cos(${angl}*PI/180)*${vel_chem}
variable    vely_chem equal sin(${angl}*PI/180)*${vel_chem}

# Adaptive timestep (used for both neutral and ion loops)
fix         ats all dt/reset 1 NULL 1 0.01 units box

# ========================= Begin neutral deposition loop =========================
if "${current_flux_ratio} == 0" then "jump SELF skip_chem"
if "${cn_start} > 0 && ${cn_start} < ${current_flux_ratio}" then &
"variable neutral_lp loop $(v_current_flux_ratio-v_cn_start)" &
elif "${cn_start} == ${current_flux_ratio}" &
"jump SELF skip_chem" &
else &
"variable neutral_lp loop ${current_flux_ratio}"

label       neutral_loop
variable    cn equal ${cn}+1
variable    deposeed equal floor(random(1,72099+${seed_adjust},${cn}))
group       insert clear
group       mobile subtract all anchor
group nonargon type 1 2 3

# Deposit O• radical (always type 3)
fix         depo insert deposit 1 3 1 ${deposeed} global ${chemical_i_above} ${chemical_i_above} vx 0.0 0.0 vy ${vely_chem} ${vely_chem} vz -${velz_chem} -${velz_chem} region bbox units box
fix         2 mobile nve
fix         3 insert nve
dump        current_dump_n all custom 100 dumps/event_dump_n${event_count}.dump id type x y z vx vy vz fx fy fz q

timestep    1e-10
run         1 post no
group nonargon type 1 2 3
run         0
variable    starting_nclusts equal $(c_nclusts)
variable    t0 equal $(time)
variable    time_elapsed equal time-${t0}
fix         thalt all halt 1 v_time_elapsed > ${inter_neutral_time} error continue message yes

# ======================== Neutral inner loop ========================
label       continue_n_impact
run         500 pre no post no
run         0
if "$(c_nclusts) > ${starting_nclusts}" then &
"variable event_count equal ${event_count}+1" &
"variable starting_nclusts equal $(c_nclusts)"
if "${one_clust} == 0" then "include sweep.lmp"
if "$(time-v_t0) < ${inter_neutral_time}" then "jump SELF continue_n_impact"

group       carbon type 1
group       hydrogen type 2
group       oxygen type 3
variable    ncarbon equal count(carbon)
variable    nhydrogen equal count(hydrogen)
variable    noxygen equal count(oxygen)

print       "Neutral run ${cn} complete"
print       "C_COUNT_neutral: ${ncarbon}"
print       "${c} ${cn} ${ncarbon} ${nhydrogen} ${noxygen}" append ncarbon.txt
write_data  data_files/${c}_${cn}.data nofix nocoeff

unfix       thalt
undump      current_dump_n
unfix       depo
unfix       2
unfix       3
# ======================== End neutral inner loop ========================
next        neutral_lp
jump        SELF neutral_loop

label       skip_chem
variable    cn_start equal 0
variable    cn equal 0
# ========================= End neutral deposition loop =========================

# Thermalize between radicals and ion
include     thermalize.lmp

# Increment ion impact counter
variable    c equal ${c}+1
variable    deposeed equal floor(random(1,72099+${seed_adjust},${c}))

# Deposit ion (O2 via molecule file, all others as single atom)
if "${current_use_molecule} == 1" then &
"fix depo insert deposit 1 0 1 ${deposeed} global ${ion_i_above} ${ion_i_above} vx 0.0 0.0 vy ${vely_ion} ${vely_ion} vz -${velz_ion} -${velz_ion} region bbox units box mol O2" &
else &
"fix depo insert deposit 1 ${current_ion_type} 1 ${deposeed} global ${ion_i_above} ${ion_i_above} vx 0.0 0.0 vy ${vely_ion} ${vely_ion} vz -${velz_ion} -${velz_ion} region bbox units box"
fix         2 mobile nve
fix         3 insert nve
dump        current_dump_ion all custom 100 dumps/event_dump_ion${event_count}.dump id type x y z vx vy vz fx fy fz q

timestep    1e-10
run         1 post no
group nonargon type 1 2 3
run         0
variable    starting_nclusts equal $(c_nclusts)
thermo      100
variable    t0 equal $(time)
variable    time_elapsed equal time-${t0}
fix         thalt all halt 1 v_time_elapsed > ${impact_time} error continue message yes
run         0
variable    n_channelled equal 0

# =========================== Ion inner loop ===========================
label       continue_impact
run         1000000000 pre no post no
run         0
if "$(c_nclusts) > ${starting_nclusts}" then &
"variable event_count equal ${event_count}+1" &
"variable starting_nclusts equal $(c_nclusts)"
variable    n_channelled equal 0
if "${one_clust} == 0" then &
"include sweep.lmp" &
"region channelled block INF INF INF INF INF ${bottom} units lattice" &
"group channelled_group region channelled" &
"variable n_channelled equal count(channelled_group)" &
"region channelled delete"

if "${n_channelled} > 0" then &
"delete_atoms group channelled_group" &
"run 0" &
"group channelled_group delete" &
"variable n_channelled equal 0"

if "$(time-v_t0) < ${impact_time}" then "jump SELF continue_impact"
unfix       thalt
# =========================== End ion inner loop ===========================

unfix       depo
unfix       ats

if "${current_needs_removal} == 1" then &
"group       ArRemove type 4" &
"delete_atoms group ArRemove" &
"group       ArRemove delete"

if "${one_clust} == 0" then "include sweep.lmp"

# Thermalize
include     thermalize.lmp

unfix       2
unfix       3

# Replenish carbon if etched below baseline
group       carbon type 1
group       hydrogen type 2
group       oxygen type 3
variable    ncarbon equal count(carbon)
variable    nhydrogen equal count(hydrogen)
variable    noxygen equal count(oxygen)
label       addfix
if "${ncarbon}<${n_lat_0}" then &
"include addfix.lmp" &
"fix 2 mobile nve" &
"include thermalize.lmp" &
"unfix 2"
if "${ncarbon}<${n_lat_0}" then "jump SELF addfix"

print       "Run ${c} complete"
print       "C_COUNT: ${ncarbon}"
print       "${c} 0 ${ncarbon} ${nhydrogen} ${noxygen}" append ncarbon.txt

write_data  data_files/${c}_0.data nofix nocoeff
if '$(v_c%v_ML) == 0' then "write_dump all custom dumps/dump.dump id type x y z vx vy vz q modify sort id append yes"

undump      current_dump_ion
# ========================= End Per-Impact Outer Loop =========================
next        a
jump        SELF loop
