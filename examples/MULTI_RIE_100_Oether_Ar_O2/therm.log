
timestep 	0.25

label setuploop
variable dz equal ceil(($(zhi)-$(zlo))/16) #16 groups max to prevent going over 36 total
variable dz equal ceil((35.65387168769900228-$(zlo))/16) 
variable dz equal ceil((35.65387168769900228--18.272609239945737158)/16) 
if "${dz}<5" then "variable dz equal 5" # minimum lat_a
variable dz equal 5
variable zbottom equal ceil(${bottom}*${lat_a}/sqrt(2)) # for 001
variable zbottom equal ceil(-5.125*${lat_a}/sqrt(2)) 
variable zbottom equal ceil(-5.125*3.5653871687699/sqrt(2)) 
# variable zbottom equal ceil(${bottom}*${lat_a}*sqrt(3)) # for 111
variable zbottom0 equal $(v_zbottom)
variable zbottom0 equal -12
# =============================== begin thermostat setting loop ==========
label set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _12
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal -12+${dz}
variable ztop equal -12+5
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r_12 block INF INF INF INF ${zbottom} ${ztop} units box
region r_12 block INF INF INF INF -12 ${ztop} units box
region r_12 block INF INF INF INF -12 -7 units box
group temp region r${zname}
group temp region r_12
214 atoms in group temp
group g${zname} subtract temp anchor
group g_12 subtract temp anchor
214 atoms in group g_12
group temp delete
region r${zname} delete # we don't need the region anymore
region r_12 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g_12)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_12 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_12 g_12 temp/berendsen $T $T $(250*dt)
fix		    t_12 g_12 temp/berendsen 300 $T $(250*dt)
fix		    t_12 g_12 temp/berendsen 300 300 $(250*dt)
fix		    t_12 g_12 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal -7
jump SELF set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _7
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal -7+${dz}
variable ztop equal -7+5
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r_7 block INF INF INF INF ${zbottom} ${ztop} units box
region r_7 block INF INF INF INF -7 ${ztop} units box
region r_7 block INF INF INF INF -7 -2 units box
group temp region r${zname}
group temp region r_7
182 atoms in group temp
group g${zname} subtract temp anchor
group g_7 subtract temp anchor
182 atoms in group g_7
group temp delete
region r${zname} delete # we don't need the region anymore
region r_7 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g_7)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_7 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_7 g_7 temp/berendsen $T $T $(250*dt)
fix		    t_7 g_7 temp/berendsen 300 $T $(250*dt)
fix		    t_7 g_7 temp/berendsen 300 300 $(250*dt)
fix		    t_7 g_7 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal -2
jump SELF set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _2
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal -2+${dz}
variable ztop equal -2+5
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r_2 block INF INF INF INF ${zbottom} ${ztop} units box
region r_2 block INF INF INF INF -2 ${ztop} units box
region r_2 block INF INF INF INF -2 3 units box
group temp region r${zname}
group temp region r_2
213 atoms in group temp
group g${zname} subtract temp anchor
group g_2 subtract temp anchor
213 atoms in group g_2
group temp delete
region r${zname} delete # we don't need the region anymore
region r_2 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g_2)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_2 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_2 g_2 temp/berendsen $T $T $(250*dt)
fix		    t_2 g_2 temp/berendsen 300 $T $(250*dt)
fix		    t_2 g_2 temp/berendsen 300 300 $(250*dt)
fix		    t_2 g_2 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal 3
jump SELF set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 3
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal 3+${dz}
variable ztop equal 3+5
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
