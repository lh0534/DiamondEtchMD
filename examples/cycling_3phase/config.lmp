# DiamondEtchMD generated config (cycling mode)
# orientation=100  surface=O_ether  T=300.0K
# phases: Ar@50.0eV×5ML, O@1.0eV×3ML+O•R5, O2@20.0eV×5ML+O•R2
# 3 cycle(s) × 13 ML/cycle = 39 ML total

variable    ML equal 64            # atoms per monolayer
variable    cycles equal 3
variable    end_fluence equal 39  # total ML

variable    angl equal 0.0       # incident angle (deg from normal)
variable    T equal 300.0    # substrate temperature (K)
variable    pot string REAX

variable    use_starting_data_file equal false
variable    starting_data_file string data.truncated

if "${pot} == REAX" then &
"variable    lat_a file lat_a.txt"

variable    x equal 6
variable    y equal 6
variable    lat_top equal 4
variable    z equal ${lat_top}+5

variable    reconstruct equal false
variable    O_terminate equal false
variable    O_ether_terminate equal true

variable    impact_time equal 2000.0
variable    thermalization_time equal 500.0
variable    inter_neutral_time equal 1000.0

variable    ion_i_above equal 6.0     # Å above surface to inject ion
variable    chemical_i_above equal 6.0 # Å above surface to inject O•

variable    M_C equal 12.011
variable    M_H equal 1.00784
variable    M_O equal 16.0
variable    M_Ar equal 39.948

variable    seed_adjust equal 0

# Per-phase parameters
variable    phase_0_ml equal 5       # ML per cycle (Ar)
variable    phase_0_energy equal 50.0 # eV/atom
variable    phase_0_flux_ratio equal 0
variable    phase_0_radical_energy equal 0.2
variable    phase_1_ml equal 3       # ML per cycle (O)
variable    phase_1_energy equal 1.0 # eV/atom
variable    phase_1_flux_ratio equal 5
variable    phase_1_radical_energy equal 0.2
variable    phase_2_ml equal 5       # ML per cycle (O2)
variable    phase_2_energy equal 10.0 # eV/atom
variable    phase_2_flux_ratio equal 2
variable    phase_2_radical_energy equal 0.2
