package kokkos
package kokkos neigh/qeq full neigh half newton on
units		real
include     config.lmp
# DiamondEtchMD generated config
# orientation=113  surface=
# species=O  energy=0.5eV  angle=0.0deg  T=300.0K

variable    ML equal 108            # atoms per monolayer
variable    end_fluence equal 50   # in ML

variable    energ equal 0.5     # incident energy per atom (eV)
variable    angl equal 0.0       # incident particle angle (deg from normal)
variable    T equal 300.0    # substrate temperature (K)
variable    pot string REAX

variable    use_starting_data_file equal false
variable    starting_data_file string data.truncated

if "${pot} == REAX" then "variable    lat_a file lat_a.txt"
variable    lat_a file lat_a.txt

variable    x equal 9
variable    y equal 3
variable    lat_top equal 3
variable    z equal ${lat_top}+5
variable    z equal 3+5

variable    reconstruct equal false
variable    O_terminate equal false
variable    O_ether_terminate equal false

variable    i_above equal 6.0    # Å above surface to inject particle
variable    impact_time equal 2000.0
variable    thermalization_time equal 500.0

variable    M_C equal 12.011
variable    M_H equal 1.00784
variable    M_O equal 16.0
variable    M_Ar equal 39.948
variable    M_incident equal ${M_O}
variable    M_incident equal 16
variable    incident_type_index equal 3  # O

variable    seed_adjust equal 0
variable    simdepo equal 1
atom_style charge

boundary	p p m

variable    bottom equal -5/8 # edge is in the gap between layers to avoid flop issues
print       'BOTTOM ${bottom}'
BOTTOM -0.625

# Create the entire simulation space "big box" with 3 types of atoms (C, H, O)
lattice    diamond ${lat_a} orient z 1 1 3 orient x -1 1 0 orient y -3 -3 2 spacing $(1/sqrt(2)) $(11/sqrt(22)) $(5/sqrt(11)) origin 0 0 0
lattice    diamond 3.5653871687699 orient z 1 1 3 orient x -1 1 0 orient y -3 -3 2 spacing $(1/sqrt(2)) $(11/sqrt(22)) $(5/sqrt(11)) origin 0 0 0
lattice    diamond 3.5653871687699 orient z 1 1 3 orient x -1 1 0 orient y -3 -3 2 spacing 0.70710678118654746172 $(11/sqrt(22)) $(5/sqrt(11)) origin 0 0 0
lattice    diamond 3.5653871687699 orient z 1 1 3 orient x -1 1 0 orient y -3 -3 2 spacing 0.70710678118654746172 2.3452078799117148655 $(5/sqrt(11)) origin 0 0 0
lattice    diamond 3.5653871687699 orient z 1 1 3 orient x -1 1 0 orient y -3 -3 2 spacing 0.70710678118654746172 2.3452078799117148655 1.5075567228888180349 origin 0 0 0
Lattice spacing in x,y,z = 2.5211094 8.3615741 5.3750234
region     bbox block -1e-6 ${x} -1e-6 ${y} ${bottom} ${z} units lattice
region     bbox block -1e-6 9 -1e-6 ${y} ${bottom} ${z} units lattice
region     bbox block -1e-6 9 -1e-6 3 ${bottom} ${z} units lattice
region     bbox block -1e-6 9 -1e-6 3 -0.625 ${z} units lattice
region     bbox block -1e-6 9 -1e-6 3 -0.625 8 units lattice
create_box 3 bbox
Created orthogonal box = (-2.5211094e-06 -8.3615741e-06 -3.3593896) to (22.689985 25.084722 43.000187)
  1 by 1 by 1 MPI processor grid

# Create diamond cubic lattice in a subregion of bbox
region	        lbox block  -1e-6 ${x} -1e-6 ${y} $(v_bottom-1e-6) $(v_lat_top+1/4+1e-6) units lattice
region	        lbox block  -1e-6 9 -1e-6 ${y} $(v_bottom-1e-6) $(v_lat_top+1/4+1e-6) units lattice
region	        lbox block  -1e-6 9 -1e-6 3 $(v_bottom-1e-6) $(v_lat_top+1/4+1e-6) units lattice
region	        lbox block  -1e-6 9 -1e-6 3 -0.62500100000000002876 $(v_lat_top+1/4+1e-6) units lattice
region	        lbox block  -1e-6 9 -1e-6 3 -0.62500100000000002876 3.2500010000000001398 units lattice
variable        sublat equal ${bottom}+1/2 # 2 layers == half a unit cell
variable        sublat equal -0.625+1/2 
region          anchor block INF INF INF INF ${bottom} ${sublat} units lattice # anchor bottom 2 layers
region          anchor block INF INF INF INF -0.625 ${sublat} units lattice 
region          anchor block INF INF INF INF -0.625 -0.125 units lattice 

if "${use_starting_data_file}" then     "read_data       ${starting_data_file} add merge"     "group carbon type 1"     "variable        n_lat_0  equal $(count(carbon)) # n_lat_0 is the starting number of carbon" else     "create_atoms    1 region lbox"     "variable        n_lat_0  equal $(8*v_x*v_y*v_lat_top) # 8 times the number of unit cells for 113"
create_atoms    1 region lbox
Created 2160 atoms
  using lattice units in orthogonal box = (-2.5211094e-06 -8.3615741e-06 -3.3593896) to (22.689985 25.084722 43.000187)
  create_atoms CPU = 0.005 seconds
variable        n_lat_0  equal $(8*v_x*v_y*v_lat_top) # 8 times the number of unit cells for 113
variable        n_lat_0  equal 648 

set group all charge 0.0
Setting atom values ...
  2160 settings made for charge
print 'N_LAT_0 ${n_lat_0}'
N_LAT_0 648

# Groups
group 	anchor region anchor
324 atoms in group anchor
group	insert empty
0 atoms in group insert
group 	mobile subtract all anchor
1836 atoms in group mobile
group   carbon type 1
2160 atoms in group carbon

# Particle masses
mass        1 ${M_C}
mass        1 12.011
mass        2 ${M_H}
mass        2 1.00784
mass        3 ${M_O}
mass        3 16

# Potential
pair_style reaxff NULL
pair_coeff * * ffield.reax C H O
Reading potential file ffield.reax with DATE: 2011-02-18
