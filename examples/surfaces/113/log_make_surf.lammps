# no reconstruction for 113

if "${O_terminate} && !${use_starting_data_file}" then "variable term_top equal ${lat_top}+1/8" "variable term_bottom equal ${lat_top}" "region term block -1e-6 ${x} -1e-6 ${y} $(v_term_bottom-1e-6) $(v_term_top+1e-6) units lattice" "create_atoms 3 region term" "group O type 3" "displace_atoms O move 0.0 0.0 $(1/4) units lattice" "group O delete"

minimize 1.0e-5 1.0e-6 1000 10000

