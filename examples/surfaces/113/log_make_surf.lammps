fix reax_qeq all qeq/reaxff 1 0.0 6.0 1e-6 reaxff

change_box all x final 0 ${x} y final 0 ${y} z final ${bottom} ${z}
change_box all x final 0 9 y final 0 ${y} z final ${bottom} ${z}
change_box all x final 0 9 y final 0 3 z final ${bottom} ${z}
change_box all x final 0 9 y final 0 3 z final -0.625 ${z}
change_box all x final 0 9 y final 0 3 z final -0.625 8
