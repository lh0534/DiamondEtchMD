
timestep 	0.25

label setuploop
variable dz equal ceil(($(zhi)-$(zlo))/16) #16 groups max to prevent going over 36 total
variable dz equal ceil((32.967002315283544078-$(zlo))/16) 
variable dz equal ceil((32.967002315283544078--62.839948849569516653)/16) 
if "${dz}<5" then "variable dz equal 5" # minimum lat_a
variable zbottom equal ceil(${bottom}*${lat_a}/sqrt(2)) # for 001
variable zbottom equal ceil(-17.625*${lat_a}/sqrt(2)) 
variable zbottom equal ceil(-17.625*3.5653871687699/sqrt(2)) 
# variable zbottom equal ceil(${bottom}*${lat_a}*sqrt(3)) # for 111
variable zbottom0 equal $(v_zbottom)
variable zbottom0 equal -44
# =============================== begin thermostat setting loop ==========
label set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _44
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal -44+${dz}
variable ztop equal -44+6
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r_44 block INF INF INF INF ${zbottom} ${ztop} units box
region r_44 block INF INF INF INF -44 ${ztop} units box
region r_44 block INF INF INF INF -44 -38 units box
group temp region r${zname}
group temp region r_44
78 atoms in group temp
group g${zname} subtract temp anchor
group g_44 subtract temp anchor
78 atoms in group g_44
group temp delete
region r${zname} delete # we don't need the region anymore
region r_44 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g_44)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_44 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_44 g_44 temp/berendsen $T $T $(250*dt)
fix		    t_44 g_44 temp/berendsen 300 $T $(250*dt)
fix		    t_44 g_44 temp/berendsen 300 300 $(250*dt)
fix		    t_44 g_44 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal -38
jump SELF set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _38
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal -38+${dz}
variable ztop equal -38+6
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r_38 block INF INF INF INF ${zbottom} ${ztop} units box
region r_38 block INF INF INF INF -38 ${ztop} units box
region r_38 block INF INF INF INF -38 -32 units box
group temp region r${zname}
group temp region r_38
20 atoms in group temp
group g${zname} subtract temp anchor
group g_38 subtract temp anchor
20 atoms in group g_38
group temp delete
region r${zname} delete # we don't need the region anymore
region r_38 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g_38)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_38 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_38 g_38 temp/berendsen $T $T $(250*dt)
fix		    t_38 g_38 temp/berendsen 300 $T $(250*dt)
fix		    t_38 g_38 temp/berendsen 300 300 $(250*dt)
fix		    t_38 g_38 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal -32
jump SELF set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _32
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal -32+${dz}
variable ztop equal -32+6
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r_32 block INF INF INF INF ${zbottom} ${ztop} units box
region r_32 block INF INF INF INF -32 ${ztop} units box
region r_32 block INF INF INF INF -32 -26 units box
group temp region r${zname}
group temp region r_32
1 atoms in group temp
group g${zname} subtract temp anchor
group g_32 subtract temp anchor
1 atoms in group g_32
group temp delete
region r${zname} delete # we don't need the region anymore
region r_32 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g_32)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_32 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_32 g_32 temp/berendsen $T $T $(250*dt)
fix		    t_32 g_32 temp/berendsen 300 $T $(250*dt)
fix		    t_32 g_32 temp/berendsen 300 300 $(250*dt)
fix		    t_32 g_32 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal -26
jump SELF set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _26
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal -26+${dz}
variable ztop equal -26+6
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r_26 block INF INF INF INF ${zbottom} ${ztop} units box
region r_26 block INF INF INF INF -26 ${ztop} units box
region r_26 block INF INF INF INF -26 -20 units box
group temp region r${zname}
group temp region r_26
0 atoms in group temp
group g${zname} subtract temp anchor
group g_26 subtract temp anchor
0 atoms in group g_26
group temp delete
region r${zname} delete # we don't need the region anymore
region r_26 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g_26)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
# note thermostat damping is 250x the timestep, 10% of the thermostat time
# ================================= end thermostat setting loop ==========

# unset empty group and region
variable zbottom_final equal ${zbottom}
variable zbottom_final equal -26
group g${zname} delete
group g_26 delete

# run thermostats
log ${log_file} append # ok log this part
log log4.lammps append 

variable zbottom equal ${zbottom0}
variable zbottom equal -44
# =============================== begin thermostat UNsetting loop ========
label unset_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _44
unfix t${zname}
unfix t_44
group g${zname} delete
group g_44 delete
variable zbottom equal ${zbottom}+${dz}
variable zbottom equal -44+${dz}
variable zbottom equal -44+6
if "${zbottom}!=${zbottom_final}" then "jump SELF unset_loop_start"
jump SELF unset_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _38
unfix t${zname}
unfix t_38
group g${zname} delete
group g_38 delete
variable zbottom equal ${zbottom}+${dz}
variable zbottom equal -38+${dz}
variable zbottom equal -38+6
if "${zbottom}!=${zbottom_final}" then "jump SELF unset_loop_start"
jump SELF unset_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _32
unfix t${zname}
unfix t_32
group g${zname} delete
group g_32 delete
variable zbottom equal ${zbottom}+${dz}
variable zbottom equal -32+${dz}
variable zbottom equal -32+6
if "${zbottom}!=${zbottom_final}" then "jump SELF unset_loop_start"
# ================================= end UNthermostat setting loop ========
log ${log_file} append
log log4.lammps append
