# DiamondEtchMD generated config (cycling mode)
# orientation=100  surface=O_ether  T=300.0K
# phases: Ar@30.0eV×20ML, O2@12.0eV×30ML+O•R1
# 3 cycle(s) × 50 ML/cycle = 150 ML total

variable    ML equal 64            # atoms per monolayer
variable    cycles equal 3
variable    end_fluence equal 150  # total ML

variable    ion_angl equal 0.0   # ion beam angle (deg from normal)
variable    T equal 300.0    # substrate temperature (K)
variable    pot string REAX

variable    use_starting_data_file equal false
variable    starting_data_file string data.truncated

if "${pot} == REAX" then &
"variable    lat_a file lat_a.txt"

variable    x equal 8
variable    y equal 8
variable    lat_top equal 3
variable    z equal ${lat_top}+5

variable    reconstruct equal false
variable    O_terminate equal false
variable    O_ether_terminate equal true

variable    impact_time equal 1000.0
variable    thermalization_time equal 500.0

variable    ion_i_above equal 6.0     # Å above surface to inject ion
variable    radical_i_above equal 12.0  # Å above surface to inject O• radical

variable    M_C equal 12.011
variable    M_H equal 1.00784
variable    M_O equal 16.0
variable    M_Ar equal 39.948

variable    seed_adjust equal 0

# Per-phase parameters
variable    phase_0_ml equal 20       # ML per cycle (Ar)
variable    phase_0_energy equal 30.0 # eV/atom
variable    phase_0_flux_ratio equal 0
variable    phase_1_ml equal 30       # ML per cycle (O2)
variable    phase_1_energy equal 6.0 # eV/atom
variable    phase_1_flux_ratio equal 1
variable    phase_1_radical_energy equal 0.2
variable    phase_1_radical_i_above equal 12.0
variable    phase_1_inter_neutral_time equal 1500.0
variable    phase_1_rad_angl equal 0.0
