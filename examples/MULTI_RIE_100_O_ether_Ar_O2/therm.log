
timestep 	0.25

label setuploop
variable dz equal ceil(($(zhi)-$(zlo))/16) #16 groups max to prevent going over 36 total
variable dz equal ceil((87.909375593319722952-$(zlo))/16) 
variable dz equal ceil((87.909375593319722952--4.01106056486613749)/16) 
if "${dz}<5" then "variable dz equal 5" # minimum lat_a
variable zbottom equal ceil(${bottom}*${lat_a}/sqrt(2)) # for 001
variable zbottom equal ceil(-1.125*${lat_a}/sqrt(2)) 
variable zbottom equal ceil(-1.125*3.5653871687699/sqrt(2)) 
# variable zbottom equal ceil(${bottom}*${lat_a}*sqrt(3)) # for 111
variable zbottom0 equal $(v_zbottom)
variable zbottom0 equal -2
# =============================== begin thermostat setting loop ==========
label set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _2
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal -2+${dz}
variable ztop equal -2+6
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r_2 block INF INF INF INF ${zbottom} ${ztop} units box
region r_2 block INF INF INF INF -2 ${ztop} units box
region r_2 block INF INF INF INF -2 4 units box
group temp region r${zname}
group temp region r_2
252 atoms in group temp
group g${zname} subtract temp anchor
group g_2 subtract temp anchor
252 atoms in group g_2
group temp delete
region r${zname} delete # we don't need the region anymore
region r_2 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g_2)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_2 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_2 g_2 temp/berendsen $T $T $(250*dt)
fix		    t_2 g_2 temp/berendsen 300 $T $(250*dt)
fix		    t_2 g_2 temp/berendsen 300 300 $(250*dt)
fix		    t_2 g_2 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal 4
jump SELF set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 4
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal 4+${dz}
variable ztop equal 4+6
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r4 block INF INF INF INF ${zbottom} ${ztop} units box
region r4 block INF INF INF INF 4 ${ztop} units box
region r4 block INF INF INF INF 4 10 units box
group temp region r${zname}
group temp region r4
252 atoms in group temp
group g${zname} subtract temp anchor
group g4 subtract temp anchor
252 atoms in group g4
group temp delete
region r${zname} delete # we don't need the region anymore
region r4 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g4)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t4 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t4 g4 temp/berendsen $T $T $(250*dt)
fix		    t4 g4 temp/berendsen 300 $T $(250*dt)
fix		    t4 g4 temp/berendsen 300 300 $(250*dt)
fix		    t4 g4 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal 10
jump SELF set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 10
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal 10+${dz}
variable ztop equal 10+6
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r10 block INF INF INF INF ${zbottom} ${ztop} units box
region r10 block INF INF INF INF 10 ${ztop} units box
region r10 block INF INF INF INF 10 16 units box
group temp region r${zname}
group temp region r10
219 atoms in group temp
group g${zname} subtract temp anchor
group g10 subtract temp anchor
219 atoms in group g10
group temp delete
region r${zname} delete # we don't need the region anymore
region r10 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g10)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t10 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t10 g10 temp/berendsen $T $T $(250*dt)
fix		    t10 g10 temp/berendsen 300 $T $(250*dt)
fix		    t10 g10 temp/berendsen 300 300 $(250*dt)
fix		    t10 g10 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal 16
jump SELF set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 16
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal 16+${dz}
variable ztop equal 16+6
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r16 block INF INF INF INF ${zbottom} ${ztop} units box
region r16 block INF INF INF INF 16 ${ztop} units box
region r16 block INF INF INF INF 16 22 units box
group temp region r${zname}
group temp region r16
138 atoms in group temp
group g${zname} subtract temp anchor
group g16 subtract temp anchor
138 atoms in group g16
group temp delete
region r${zname} delete # we don't need the region anymore
region r16 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g16)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t16 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t16 g16 temp/berendsen $T $T $(250*dt)
fix		    t16 g16 temp/berendsen 300 $T $(250*dt)
fix		    t16 g16 temp/berendsen 300 300 $(250*dt)
fix		    t16 g16 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal 22
jump SELF set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 22
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal 22+${dz}
variable ztop equal 22+6
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r22 block INF INF INF INF ${zbottom} ${ztop} units box
region r22 block INF INF INF INF 22 ${ztop} units box
region r22 block INF INF INF INF 22 28 units box
group temp region r${zname}
group temp region r22
0 atoms in group temp
group g${zname} subtract temp anchor
group g22 subtract temp anchor
0 atoms in group g22
group temp delete
region r${zname} delete # we don't need the region anymore
region r22 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g22)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
# note thermostat damping is 250x the timestep, 10% of the thermostat time
# ================================= end thermostat setting loop ==========

# unset empty group and region
variable zbottom_final equal ${zbottom}
variable zbottom_final equal 22
group g${zname} delete
group g22 delete

# run thermostats
log ${log_file} append # ok log this part
log log2.lammps append 

variable zbottom equal ${zbottom0}
variable zbottom equal -2
# =============================== begin thermostat UNsetting loop ========
label unset_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _2
unfix t${zname}
unfix t_2
group g${zname} delete
group g_2 delete
variable zbottom equal ${zbottom}+${dz}
variable zbottom equal -2+${dz}
variable zbottom equal -2+6
if "${zbottom}!=${zbottom_final}" then "jump SELF unset_loop_start"
jump SELF unset_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 4
unfix t${zname}
unfix t4
group g${zname} delete
group g4 delete
variable zbottom equal ${zbottom}+${dz}
variable zbottom equal 4+${dz}
variable zbottom equal 4+6
if "${zbottom}!=${zbottom_final}" then "jump SELF unset_loop_start"
jump SELF unset_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 10
unfix t${zname}
unfix t10
group g${zname} delete
group g10 delete
variable zbottom equal ${zbottom}+${dz}
variable zbottom equal 10+${dz}
variable zbottom equal 10+6
if "${zbottom}!=${zbottom_final}" then "jump SELF unset_loop_start"
jump SELF unset_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 16
unfix t${zname}
unfix t16
group g${zname} delete
group g16 delete
variable zbottom equal ${zbottom}+${dz}
variable zbottom equal 16+${dz}
variable zbottom equal 16+6
if "${zbottom}!=${zbottom_final}" then "jump SELF unset_loop_start"
# ================================= end UNthermostat setting loop ========
log ${log_file} append
log log2.lammps append
