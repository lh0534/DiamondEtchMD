#!/bin/bash
#SBATCH --job-name=graphullerene_Ar
#SBATCH --nodes=1
#SBATCH --mem=16G
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --gres=gpu:1
#SBATCH --time=1:00:00
#SBATCH --dependency=singleton
#SBATCH --signal=B:USR1@120
#SBATCH --nice=2
#SBATCH --account=dgraves

module purge
module load lammps/kokkos/gpu_della9_2022

mkdir -p etch_event_trajs impact_snaps penetration

export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
export OMP_PROC_BIND=spread
export OMP_PLACES=threads

_resubmitted=0
_resubmit() {
    local nc ml ef ec
    nc=$(tail -1 ncarbon.txt 2>/dev/null | awk '{print $1}'); nc=${nc:-0}
    ml=$(grep 'ML equal' config.lmp | awk '{print $4}')
    ef=$(grep 'end_fluence equal' config.lmp | awk '{print $4}')
    ec=$(( ef * ml ))
    if [ "$nc" -lt "$ec" ] && [ ! -f SLAB_DEPLETED ]; then
        echo "Wall-time signal: $nc / $ec impacts done — re-submitting."
        [ -n "$_PLOT_PID" ] && kill "$_PLOT_PID" 2>/dev/null; wait "$_PLOT_PID" 2>/dev/null || true
[ -n "$_CNA_PID" ]  && kill "$_CNA_PID"  2>/dev/null; wait "$_CNA_PID"  2>/dev/null || true
[ -n "$_DUMP_PID" ] && kill "$_DUMP_PID" 2>/dev/null; wait "$_DUMP_PID" 2>/dev/null || true
        sbatch "$0"
        _resubmitted=1
    fi
}
trap '_resubmit' USR1

# First run uses initial_config.data; restarts use latest impact_snaps snapshot
n_complete=$(tail -1 ncarbon.txt 2>/dev/null | awk '{print $1}')
n_complete=${n_complete:-0}
data_file=$(ls -t impact_snaps/*.data 2>/dev/null | head -1)
data_file=${data_file:-initial_config.data}
log_file=log$(echo "$(ls | grep -c .lammps)+1" | bc).lammps
event_count=$(ls etch_event_trajs/event_dump_*.dump 2>/dev/null | wc -l)

ML=$(grep 'ML equal' config.lmp | awk '{print $4}')
end_fluence=$(grep 'end_fluence equal' config.lmp | awk '{print $4}')
end_c=$(( end_fluence * ML ))
if [ "$n_complete" -ge "$end_c" ]; then
    echo "Simulation already complete: $n_complete / $end_c impacts."
    exit 0
fi
if [ -f SLAB_DEPLETED ]; then
    echo "Slab already depleted — not re-queuing."
    exit 0
fi

[ -f LAMMPS_FAILED ] && mv LAMMPS_FAILED "LAMMPS_FAILED.$(date '+%Y%m%d_%H%M%S')"

srun lmp -k on g 1 -sf kk \
    -var data_file $data_file \
    -var n_complete $n_complete \
    -var log_file $log_file \
    -var n_events $event_count \
    -log $log_file \
    -screen none \
    -nocite \
    -in head.lmp &
SRUN_PID=$!
# Auto-plot every 12 h (--no-cna for speed during live run)
_PLOT_PID=""
( while true; do
      sleep 43200
      python3 auto-plot.py --no-cna 2>>plot.log || true
  done ) &
_PLOT_PID=$!
# CNA analysis every 12 h (cna_stride from spec.json)
_CNA_PID=""
( while true; do
      sleep 43200
      python3 auto-plot.py --cna-run 2>>plot.log || true
  done ) &
_CNA_PID=$!
# Rebuild all_impacts.dump every 12 h
_DUMP_PID=""
( while true; do
      sleep 43200
      python3 make_impact_dump.py . 2>>plot.log || true
  done ) &
_DUMP_PID=$!
wait $SRUN_PID
lmp_exit=$?
[ -n "$_PLOT_PID" ] && kill "$_PLOT_PID" 2>/dev/null; wait "$_PLOT_PID" 2>/dev/null || true
[ -n "$_CNA_PID" ]  && kill "$_CNA_PID"  2>/dev/null; wait "$_CNA_PID"  2>/dev/null || true
[ -n "$_DUMP_PID" ] && kill "$_DUMP_PID" 2>/dev/null; wait "$_DUMP_PID" 2>/dev/null || true

[ $_resubmitted -eq 1 ] && exit 0

if [ $lmp_exit -ne 0 ]; then
    echo "LAMMPS exited with code $lmp_exit — not re-submitting."
    err=$(grep '^ERROR:' "$log_file" 2>/dev/null | tail -1)
    [ -z "$err" ] && err="LAMMPS exited with code $lmp_exit (no ERROR line in $log_file)"
    n_at_fail=$(tail -1 ncarbon.txt 2>/dev/null | awk '{print $1}'); n_at_fail=${n_at_fail:-0}
    echo "$(date '+%Y-%m-%d %H:%M:%S')  impact=$n_at_fail  $err" >> LAMMPS_FAILED
    exit $lmp_exit
fi

if [ -f SLAB_DEPLETED ]; then
    echo "Slab depleted after $n_complete impacts — not re-submitting."
    echo "Running final analysis plots ..."
python3 auto-plot.py --cna-stride $ML 2>>plot.log || true
    exit 0
fi

n_complete=$(tail -1 ncarbon.txt 2>/dev/null | awk '{print $1}')
n_complete=${n_complete:-0}
if [ "$n_complete" -lt "$end_c" ]; then
    echo "Progress: $n_complete / $end_c impacts. Re-submitting..."
    sbatch "$0"
else
    echo "Simulation complete: $n_complete / $end_c impacts."
    echo "Running final analysis plots ..."
python3 auto-plot.py --cna-stride $ML 2>>plot.log || true
fi
