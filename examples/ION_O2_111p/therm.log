
timestep 	0.25

label setuploop
variable dz equal ceil(($(zhi)-$(zlo))/16) #16 groups max to prevent going over 36 total
variable dz equal ceil((67.929748974599803546-$(zlo))/16) 
variable dz equal ceil((67.929748974599803546--3.8596448281022617266)/16) 
if "${dz}<5" then "variable dz equal 5" # minimum lat_a
variable zbottom equal ceil(${bottom}*${lat_a}/sqrt(2)) # for 001
variable zbottom equal ceil(-0.625*${lat_a}/sqrt(2)) 
variable zbottom equal ceil(-0.625*3.5653871687699/sqrt(2)) 
# variable zbottom equal ceil(${bottom}*${lat_a}*sqrt(3)) # for 111
variable zbottom0 equal $(v_zbottom)
variable zbottom0 equal -1
# =============================== begin thermostat setting loop ==========
label set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _1
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal -1+${dz}
variable ztop equal -1+5
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r_1 block INF INF INF INF ${zbottom} ${ztop} units box
region r_1 block INF INF INF INF -1 ${ztop} units box
region r_1 block INF INF INF INF -1 4 units box
group temp region r${zname}
group temp region r_1
360 atoms in group temp
group g${zname} subtract temp anchor
group g_1 subtract temp anchor
360 atoms in group g_1
group temp delete
region r${zname} delete # we don't need the region anymore
region r_1 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g_1)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_1 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_1 g_1 temp/berendsen $T $T $(250*dt)
fix		    t_1 g_1 temp/berendsen 300 $T $(250*dt)
fix		    t_1 g_1 temp/berendsen 300 300 $(250*dt)
fix		    t_1 g_1 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal 4
