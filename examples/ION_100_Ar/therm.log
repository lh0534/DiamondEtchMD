
timestep 	0.25

label setuploop
variable dz equal ceil(($(zhi)-$(zlo))/16) #16 groups max to prevent going over 36 total
variable dz equal ceil((81.754033270942031209-$(zlo))/16) 
variable dz equal ceil((81.754033270942031209--2.2283669804811876425)/16) 
if "${dz}<5" then "variable dz equal 5" # minimum lat_a
variable zbottom equal ceil(${bottom}*${lat_a}/sqrt(2)) # for 001
variable zbottom equal ceil(-0.625*${lat_a}/sqrt(2)) 
variable zbottom equal ceil(-0.625*3.5653871687699/sqrt(2)) 
# variable zbottom equal ceil(${bottom}*${lat_a}*sqrt(3)) # for 111
variable zbottom0 equal $(v_zbottom)
variable zbottom0 equal -1
# =============================== begin thermostat setting loop ==========
label set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _1
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal -1+${dz}
variable ztop equal -1+6
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r_1 block INF INF INF INF ${zbottom} ${ztop} units box
region r_1 block INF INF INF INF -1 ${ztop} units box
region r_1 block INF INF INF INF -1 5 units box
group temp region r${zname}
group temp region r_1
448 atoms in group temp
group g${zname} subtract temp anchor
group g_1 subtract temp anchor
384 atoms in group g_1
group temp delete
region r${zname} delete # we don't need the region anymore
region r_1 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g_1)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_1 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_1 g_1 temp/berendsen $T $T $(250*dt)
fix		    t_1 g_1 temp/berendsen 300 $T $(250*dt)
fix		    t_1 g_1 temp/berendsen 300 300 $(250*dt)
fix		    t_1 g_1 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal 5
jump SELF set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 5
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal 5+${dz}
variable ztop equal 5+6
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r5 block INF INF INF INF ${zbottom} ${ztop} units box
region r5 block INF INF INF INF 5 ${ztop} units box
region r5 block INF INF INF INF 5 11 units box
group temp region r${zname}
group temp region r5
448 atoms in group temp
group g${zname} subtract temp anchor
group g5 subtract temp anchor
448 atoms in group g5
group temp delete
region r${zname} delete # we don't need the region anymore
region r5 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g5)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t5 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t5 g5 temp/berendsen $T $T $(250*dt)
fix		    t5 g5 temp/berendsen 300 $T $(250*dt)
fix		    t5 g5 temp/berendsen 300 300 $(250*dt)
fix		    t5 g5 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal 11
jump SELF set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 11
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal 11+${dz}
variable ztop equal 11+6
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r11 block INF INF INF INF ${zbottom} ${ztop} units box
region r11 block INF INF INF INF 11 ${ztop} units box
region r11 block INF INF INF INF 11 17 units box
group temp region r${zname}
group temp region r11
256 atoms in group temp
group g${zname} subtract temp anchor
group g11 subtract temp anchor
256 atoms in group g11
group temp delete
region r${zname} delete # we don't need the region anymore
region r11 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g11)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t11 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t11 g11 temp/berendsen $T $T $(250*dt)
fix		    t11 g11 temp/berendsen 300 $T $(250*dt)
fix		    t11 g11 temp/berendsen 300 300 $(250*dt)
fix		    t11 g11 temp/berendsen 300 300 62.5
variable zbottom equal ${ztop}
variable zbottom equal 17
jump SELF set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 17
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal 17+${dz}
variable ztop equal 17+6
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r17 block INF INF INF INF ${zbottom} ${ztop} units box
region r17 block INF INF INF INF 17 ${ztop} units box
region r17 block INF INF INF INF 17 23 units box
group temp region r${zname}
group temp region r17
0 atoms in group temp
group g${zname} subtract temp anchor
group g17 subtract temp anchor
0 atoms in group g17
group temp delete
region r${zname} delete # we don't need the region anymore
region r17 delete 
variable nregion equal count(g${zname})
variable nregion equal count(g17)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
# note thermostat damping is 250x the timestep, 10% of the thermostat time
# ================================= end thermostat setting loop ==========

# unset empty group and region
variable zbottom_final equal ${zbottom}
variable zbottom_final equal 17
group g${zname} delete
group g17 delete

# run thermostats
log ${log_file} append # ok log this part
log log2.lammps append 

variable zbottom equal ${zbottom0}
variable zbottom equal -1
# =============================== begin thermostat UNsetting loop ========
label unset_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _1
unfix t${zname}
unfix t_1
group g${zname} delete
group g_1 delete
variable zbottom equal ${zbottom}+${dz}
variable zbottom equal -1+${dz}
variable zbottom equal -1+6
if "${zbottom}!=${zbottom_final}" then "jump SELF unset_loop_start"
jump SELF unset_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 5
unfix t${zname}
unfix t5
group g${zname} delete
group g5 delete
variable zbottom equal ${zbottom}+${dz}
variable zbottom equal 5+${dz}
variable zbottom equal 5+6
if "${zbottom}!=${zbottom_final}" then "jump SELF unset_loop_start"
jump SELF unset_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string $(abs(v_zbottom))
variable zname string 11
unfix t${zname}
unfix t11
group g${zname} delete
group g11 delete
variable zbottom equal ${zbottom}+${dz}
variable zbottom equal 11+${dz}
variable zbottom equal 11+6
if "${zbottom}!=${zbottom_final}" then "jump SELF unset_loop_start"
# ================================= end UNthermostat setting loop ========
log ${log_file} append
log log2.lammps append
