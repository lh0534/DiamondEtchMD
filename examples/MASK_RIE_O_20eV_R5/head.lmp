# head.lmp — generated by DiamondEtchMD
# orientation=100  species=O  20.0eV  300.0K  ion_angle=0.0deg
package kokkos neigh/qeq full neigh half newton on
units		real
include     config.lmp
if "${pot} == COMB3" then &
"atom_style charge" &
elif "${pot} == REAX" &
"atom_style charge" &
else &
"atom_style atomic"

boundary	p p m

# create_box with 4 types then merge data file so type 4 (Ar) is available
region      dummy_region block 0 1 0 1 0 1
create_box  4 dummy_region
read_data   ${data_file} add merge

variable 	lp equal $(v_end_fluence*v_ML)-${n_complete} # impacts left
variable    a loop ${lp}
variable    bottom equal $(zlo/(v_lat_a))
print       'BOTTOM ${bottom}'
print       'N_LAT_0 ${n_lat_0}'

# Regions — lattice must match make_surf.lmp for this orientation
lattice    diamond ${lat_a} orient z 0 0 1 orient x 1 1 0 orient y -1 1 0 spacing $(1/sqrt(2)) $(1/sqrt(2)) 1 origin 0 0 0
region          bbox block EDGE EDGE EDGE EDGE EDGE EDGE
region      expose_zone block $(v_mask_lo_x) $(v_mask_hi_x) $(v_mask_lo_y) $(v_mask_hi_y) EDGE EDGE units box
variable        sublat equal ${bottom}+1/2
region          anchor block INF INF INF INF ${bottom} ${sublat} units lattice

# Groups
group 	anchor region anchor
group	insert empty
group 	mobile subtract all anchor
group   carbon type 1

# Particle masses (4 types: C, H, O, O)
mass        1 ${M_C}
mass        2 ${M_H}
mass        3 ${M_O}
mass        4 ${M_O}

# Potential
if "${pot} == REAX" then &
"pair_style reaxff NULL" &
"pair_coeff * * ffield.reax C H O C" &
"fix reax_qeq all qeq/reaxff 1 0.0 6.0 1e-6 reaxff"

# Pre-run counters
variable c equal ${n_complete}
variable event_count equal ${n_events}
variable    cn_start equal ${neut_complete}
variable    cn equal 0

# Atom counts
variable	nfixed   equal count(anchor)
variable	nmobile  equal count(mobile)
variable 	ninject  equal count(insert)

# Incident particle velocity components
variable 	vel equal sqrt(2*${energ}*6.02214129*1.0e+7/${M_incident}/6242)/1000
variable 	velz equal cos(${ion_angl}*PI/180)*${vel}
variable 	vely equal sin(${ion_angl}*PI/180)*${vel}

# Energy conservation check
compute     ake all ke
compute     ape all pe
compute     ike insert ke
variable    ate equal c_ake+c_ape+ecouple

# Clustering
variable	checkevery equal 1000
compute	    clusts all cluster/atom 3.0
compute	    clust_min all reduce min c_clusts
compute	    clust_max all reduce max c_clusts
variable    one_clust equal "c_clust_min == c_clust_max"
fix		    stopclust all halt ${checkevery} v_one_clust == 0 error continue message yes

# Carbon cluster event tracking
compute     cclusts carbon cluster/atom 1.8
compute     cc1 carbon chunk/atom c_cclusts compress yes
compute     nclusts carbon reduce max c_cc1

# Thermo
thermo_style    custom step time v_ninject temp c_ike dt ecouple v_ate v_one_clust c_nclusts
compute     	mtemp mobile temp
compute_modify  mtemp dynamic/dof yes
thermo_modify   temp mtemp
thermo_modify   lost warn flush yes

print "${c}" file begin.txt

# ========================= Begin Per-Impact Outer Loop =========================
label		loop
# Refresh bbox after thermalize shrinks the box (prevents stale-region errors)
region bbox delete
region bbox block EDGE EDGE EDGE EDGE EDGE EDGE
region      expose_zone delete
region      expose_zone block $(v_mask_lo_x) $(v_mask_hi_x) $(v_mask_lo_y) $(v_mask_hi_y) EDGE EDGE units box
if "${cn_start} > 0" then "variable cn equal ${cn_start}" else "variable cn equal 0"


group       insert clear
group 	    mobile subtract all anchor

# ========= Begin radical burst deposition (1 chunk(s) × ≤5 atoms = 5 total) =========
if "${cn_start} >= 1" then "jump SELF skip_burst"

# Fixed velocity for all burst atoms
variable    vel_chem_burst equal sqrt(2*${radical_energy}*6.02214129*1.0e+7/${M_O}/6242)/1000
variable    vx_burst equal 0.0
variable    vy_burst equal v_vel_chem_burst*sin(${rad_angl}*PI/180)
variable    vz_burst equal -v_vel_chem_burst*cos(${rad_angl}*PI/180)
timestep    1e-10

# Record pre-burst O count to detect incomplete placement
group       oxygen_pre_burst type 3
variable    n_oxy_pre equal $(count(oxygen_pre_burst))
group       oxygen_pre_burst delete

# --- Burst chunk 1/1: 5 atoms (deposit phase) ---
if "$(bound(all,zmax)+v_radical_i_above+2.0) > $(zhi)" then "change_box all z delta 0 $(bound(all,zmax)+v_radical_i_above+2.0-zhi) units box" "region bbox delete" "region bbox block EDGE EDGE EDGE EDGE EDGE EDGE" "region expose_zone delete" "region expose_zone block $(v_mask_lo_x) $(v_mask_hi_x) $(v_mask_lo_y) $(v_mask_hi_y) EDGE EDGE units box" 
variable    z_ins0 equal bound(all,zmax)+${radical_i_above}
region      bzone0 block $(v_mask_lo_x) $(v_mask_hi_x) $(v_mask_lo_y) $(v_mask_hi_y) $(v_z_ins0 - 0.1) $(v_z_ins0 + 0.1) units box
group       insert clear
group       mobile subtract all anchor
variable    burst_seed0_1 equal floor(random(1,72099+${seed_adjust},${c}*100000+0*10000+1))
fix         burst_depo insert deposit 1 3 1 ${burst_seed0_1} attempt 100 vx ${vx_burst} ${vx_burst} vy ${vy_burst} ${vy_burst} vz ${vz_burst} ${vz_burst} region bzone0 near 2.0
fix         2 mobile nve
fix         3 insert nve
run         1 post no
run         0
unfix       burst_depo
unfix       2
unfix       3
variable    burst_lp0 loop 4
label       burst_dep_0
group       insert clear
group       mobile subtract all anchor
variable    burst_seed0 equal floor(random(1,72099+${seed_adjust},${c}*100000+0*10000+v_burst_lp0))
fix         burst_depo insert deposit 1 3 1 ${burst_seed0} attempt 50 vx ${vx_burst} ${vx_burst} vy ${vy_burst} ${vy_burst} vz ${vz_burst} ${vz_burst} region bzone0 near 2.0
fix         2 mobile nve
fix         3 insert nve
run         1 post no
run         0
unfix       burst_depo
unfix       2
unfix       3
next        burst_lp0
jump        SELF burst_dep_0
region      bzone0 delete
variable    z_ins0 delete

# --- Burst chunk 1/1: dynamics phase ---
# All 5 deposited atoms are now in mobile; run dynamics together
group       insert clear
group       mobile subtract all anchor
fix         2 mobile nve
fix         3 insert nve
dump        current_dump_burst all custom 100 etch_event_trajs/event_dump_burst_${c}_0.dump id type x y z vx vy vz fx fy fz q
fix         ats_burst all dt/reset 1 NULL 1.00 0.01 units box
variable    t0_burst equal $(time)
variable    burst_elapsed equal time-${t0_burst}
variable    burst_nclusts0 equal $(c_nclusts)
fix         burst_thalt all halt 1 v_burst_elapsed > ${inter_neutral_time} error continue message yes
run         0
label       burst_inner_0
run         500 pre no post no
run         0
if "$(c_nclusts) > ${burst_nclusts0}" then &
"variable event_count equal ${event_count}+1" &
"variable burst_nclusts0 equal $(c_nclusts)"
if "${one_clust} == 0" then "include sweep.lmp"
if "$(time-v_t0_burst) < ${inter_neutral_time}" then "jump SELF burst_inner_0"
unfix       burst_thalt
unfix       ats_burst
undump      current_dump_burst
unfix       2
unfix       3
timestep    1e-10


group       carbon type 1
group       hydrogen type 2
group       oxygen type 3
variable    ncarbon equal count(carbon)
variable    nhydrogen equal count(hydrogen)
variable    noxygen equal count(oxygen)

# Shortfall check: how many O atoms were actually placed?
variable    n_placed_burst equal count(oxygen)-v_n_oxy_pre
variable    shortfall_burst equal 5-v_n_placed_burst
if "${shortfall_burst} == 0" then "jump SELF burst_topup_done"

# Record incomplete burst (atom count, not halting)
print       "c=${c} placed=$(v_n_placed_burst) expected=5 shortfall=$(v_shortfall_burst)" append BURST_INCOMPLETE

# Top-up: deposit missing atoms with higher attempt count
if "$(bound(all,zmax)+v_radical_i_above+2.0) > $(zhi)" then "change_box all z delta 0 $(bound(all,zmax)+v_radical_i_above+2.0-zhi) units box" "region bbox delete" "region bbox block EDGE EDGE EDGE EDGE EDGE EDGE" "region expose_zone delete" "region expose_zone block $(v_mask_lo_x) $(v_mask_hi_x) $(v_mask_lo_y) $(v_mask_hi_y) EDGE EDGE units box" 
variable    z_topup equal bound(all,zmax)+${radical_i_above}
region      bzone_topup block $(v_mask_lo_x) $(v_mask_hi_x) $(v_mask_lo_y) $(v_mask_hi_y) $(v_z_topup - 0.1) $(v_z_topup + 0.1) units box
variable    topup_lp loop $(v_shortfall_burst)
label       burst_topup_loop
group       insert clear
group       mobile subtract all anchor
variable    topup_seed equal floor(random(1,72099+${seed_adjust},${c}*100000+99999+v_topup_lp))
fix         burst_depo insert deposit 1 3 1 ${topup_seed} attempt 1000 vx ${vx_burst} ${vx_burst} vy ${vy_burst} ${vy_burst} vz ${vz_burst} ${vz_burst} region bzone_topup near 2.0
fix         2 mobile nve
fix         3 insert nve
run         1 post no
run         0
unfix       burst_depo
unfix       2
unfix       3
next        topup_lp
jump        SELF burst_topup_loop
region      bzone_topup delete
variable    z_topup delete

# Top-up dynamics: run deposited atoms until inter_neutral_time
group       insert clear
group       mobile subtract all anchor
fix         2 mobile nve
fix         3 insert nve
fix         ats_topup all dt/reset 1 NULL 1.00 0.01 units box
variable    t0_topup equal $(time)
variable    topup_elapsed equal time-${t0_topup}
variable    burst_nclusts0 equal $(c_nclusts)
fix         topup_thalt all halt 1 v_topup_elapsed > ${inter_neutral_time} error continue message yes
run         0
label       burst_topup_inner
run         500 pre no post no
run         0
if "$(c_nclusts) > ${burst_nclusts0}" then &
"variable event_count equal ${event_count}+1" &
"variable burst_nclusts0 equal $(c_nclusts)"
if "${one_clust} == 0" then "include sweep.lmp"
if "$(time-v_t0_topup) < ${inter_neutral_time}" then "jump SELF burst_topup_inner"
unfix       topup_thalt
unfix       ats_topup
unfix       2
unfix       3
timestep    1e-10

label       burst_topup_done

print       "Burst complete"
print       "C_COUNT_burst: ${ncarbon}"
print       "${c} 1 ${ncarbon} ${nhydrogen} ${noxygen}" append ncarbon.txt
write_data  impact_snaps/${c}_1.data nofix nocoeff

label       skip_burst
variable    cn_start equal 0
variable    cn equal 0
# ========= End radical burst deposition =========

# Final thermalize before ion impact
include     thermalize.lmp

# Refresh bbox: thermalize (boundary p p m) may shrink zhi
region bbox delete
region bbox block EDGE EDGE EDGE EDGE EDGE EDGE
region      expose_zone delete
region      expose_zone block $(v_mask_lo_x) $(v_mask_hi_x) $(v_mask_lo_y) $(v_mask_hi_y) EDGE EDGE units box

variable    c equal ${c}+1
dump current_dump all custom 100 etch_event_trajs/event_dump_${c}.dump id type x y z vx vy vz fx fy fz q
variable    deposeed equal floor(random(1,72099+${seed_adjust},${c}))
fix     depo insert deposit 1 ${incident_type_index} 10000000000 ${deposeed} global ${i_above} ${i_above} vx 0.0 0.0 vy ${vely} ${vely} vz -${velz} -${velz} region expose_zone units box

fix     2 mobile nve
fix     3 insert nve

# Run 1 fs timestep to place incident particle
timestep 1e-10
run 1 post no
variable starting_nclusts equal $(c_nclusts)

# Adaptive timestep
fix ats all dt/reset 1 NULL 1.00 0.01 units box
thermo      100

variable    t0 equal $(time)
variable    time_elapsed equal time-${t0}
fix         thalt all halt 1 v_time_elapsed > ${impact_time} error continue message yes

run         0 post no
variable    n_channelled equal 0
# =========================== begin inner loop ===========================
label		continue_impact

run         1000000000 pre no post no
run         0
if "$(c_nclusts) > ${starting_nclusts}" then &
"variable event_count equal ${event_count}+1" &
"variable starting_nclusts equal $(c_nclusts)"
if "${one_clust} == 0" then &
"include sweep.lmp" &
"region channelled block INF INF INF INF INF ${bottom} units lattice" &
"group channelled_group region channelled" &
"variable n_channelled equal count(channelled_group)" &
"region channelled delete" &

if "${n_channelled} > 0" then &
"variable event_count equal ${event_count}+1" &
"delete_atoms group channelled_group" &
"run 0" &
"group channelled_group delete" &
"variable n_channelled equal 0" &
"include notify_channeled.lmp"

if "$(time-v_t0) < ${impact_time}" then "jump SELF continue_impact"
unfix thalt
# ============================ end inner loop ============================

unfix   depo
unfix   ats

# Thermalize
include thermalize.lmp

unfix       2
unfix       3

# Replenish carbon if etched below baseline
group       carbon type 1
group       hydrogen type 2
group       oxygen type 3
variable    ncarbon equal count(carbon)
variable    nhydrogen equal count(hydrogen)
variable    noxygen equal count(oxygen)
label addfix
if "${ncarbon}<${n_lat_0}" then &
"include addfix.lmp" &
"fix 2 mobile nve" &
"include thermalize.lmp" &
"unfix 2"
if "${ncarbon}<${n_lat_0}" then "jump SELF addfix"

print "Run ${c} complete"
print "C_COUNT: ${ncarbon}"
print "${c} 0 ${ncarbon} ${nhydrogen} ${noxygen}" append ncarbon.txt

write_data impact_snaps/${c}_0.data nofix nocoeff
if '$(v_c%v_ML) == 0' then "write_dump all custom ML_impacts.dump id type q x y z vx vy vz modify sort id append yes"

undump current_dump
# ========================= End Per-Impact Outer Loop =========================
next		a
jump		SELF loop
