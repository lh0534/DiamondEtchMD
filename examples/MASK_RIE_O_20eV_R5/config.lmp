# DiamondEtchMD generated config (single-species)
# orientation=100  surface=2x1
# species=O  energy=20.0eV  ion_angle=0.0deg  T=300.0K

variable    ML equal 64            # atoms per monolayer
variable    end_fluence equal 50   # in ML

variable    energ equal 20.0     # incident energy per atom (eV)
variable    ion_angl equal 0.0   # ion beam angle (deg from normal)
variable    T equal 300.0    # substrate temperature (K)
variable    pot string REAX

variable    use_starting_data_file equal false
variable    starting_data_file string data.truncated

if "${pot} == REAX" then &
"variable    lat_a file lat_a.txt"

variable    x equal 8
variable    y equal 8
variable    lat_top equal 5
variable    z equal ${lat_top}+5

variable    reconstruct equal true
variable    O_terminate equal false
variable    O_ether_terminate equal false

variable    i_above equal 6.0    # Å above surface to inject ion
variable    impact_time equal 1000.0
variable    thermalization_time equal 500.0

variable    M_C equal 12.011
variable    M_H equal 1.00784
variable    M_O equal 16.0
variable    M_incident equal ${M_O}
variable    incident_type_index equal 3  # O

variable    seed_adjust equal 0
variable    simdepo equal 1

# RIE-etch: O• radical pre-exposure before each ion impact
variable    flux_ratio equal 5
# LAMMPS 23Jun2022 Kokkos GPU bug: fix deposit (region/near) gives 12.713x too much KE.
# radical_energy set to target/12.713 = 0.2/12.713 eV.
# VERIFY: check c_ike at first radical deposit; should be 4.6120 kcal/mol.
# If c_ike = 0.3628 kcal/mol instead, the bug is fixed — remove correction.
variable    radical_energy equal 0.01573192795  # target: 0.2 eV
variable    radical_i_above equal 6.0
variable    inter_neutral_time equal 1500.0
variable    rad_angl equal 0.0

# Deposition mask: restrict ion/radical landing to the exposed window
variable    mask_width_x equal 0.3   # fraction of Lx masked on each x-face
variable    mask_lo_x    equal xlo+(xhi-xlo)*v_mask_width_x
variable    mask_hi_x    equal xhi-(xhi-xlo)*v_mask_width_x
variable    mask_width_y equal 0.3   # fraction of Ly masked on each y-face
variable    mask_lo_y    equal ylo+(yhi-ylo)*v_mask_width_y
variable    mask_hi_y    equal yhi-(yhi-ylo)*v_mask_width_y
