
timestep 	0.25

label setuploop
variable dz equal ceil(($(zhi)-$(zlo))/16) #16 groups max to prevent going over 36 total
variable dz equal ceil((35.65387168769900228-$(zlo))/16) 
variable dz equal ceil((35.65387168769900228--4.01106056486613749)/16) 
if "${dz}<5" then "variable dz equal 5" # minimum lat_a
variable dz equal 5
variable zbottom equal ceil(${bottom}*${lat_a}/sqrt(2)) # for 001
variable zbottom equal ceil(-1.125*${lat_a}/sqrt(2)) 
variable zbottom equal ceil(-1.125*3.5653871687699/sqrt(2)) 
# variable zbottom equal ceil(${bottom}*${lat_a}*sqrt(3)) # for 111
variable zbottom0 equal $(v_zbottom)
variable zbottom0 equal -2
# =============================== begin thermostat setting loop ==========
label set_loop_start
if "${zbottom} < 0" then "variable zname string _$(abs(v_zbottom))" else "variable zname string $(abs(v_zbottom))"
variable zname string _$(abs(v_zbottom))
variable zname string _2
# set thermostats
variable ztop equal ${zbottom}+${dz}
variable ztop equal -2+${dz}
variable ztop equal -2+5
region r${zname} block INF INF INF INF ${zbottom} ${ztop} units box
region r_2 block INF INF INF INF ${zbottom} ${ztop} units box
region r_2 block INF INF INF INF -2 ${ztop} units box
region r_2 block INF INF INF INF -2 3 units box
group temp_rgn region r${zname}
group temp_rgn region r_2
384 atoms in group temp_rgn
group temp_c intersect temp_rgn carbon
384 atoms in group temp_c
group g${zname} subtract temp_c anchor
group g_2 subtract temp_c anchor
384 atoms in group g_2
group temp_c delete
group temp_rgn delete
region r${zname} delete
region r_2 delete
variable nregion equal count(g${zname})
variable nregion equal count(g_2)
# while there are atoms in the group set thermostat and loop again
if "${nregion}!=0" then "fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)" "variable zbottom equal ${ztop}" "jump SELF set_loop_start"
fix		    t${zname} g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_2 g${zname} temp/berendsen $T $T $(250*dt)
fix		    t_2 g_2 temp/berendsen $T $T $(250*dt)
