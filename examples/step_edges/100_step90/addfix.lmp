# this should be updated to add fix either based on number of
# diamond cubic atoms, or the original number of atoms
# number of diamond cubic atoms can supposedly be found with
# compute ptm/atom, but this hasn't been tested
print "${c} 0 ${ncarbon} ${nhydrogen} ${noxygen}" append ncarbon.txt # report before adding so you can see things being added in ncarbon.txt

# move the bottom down
variable    bottom equal ${bottom}-1/2
print       'BOTTOM ${bottom}'
# give the current anchor atoms some velocity
velocity    anchor create ${T} 459087 loop geom
#change box size
change_box  all z delta -0.5 0 units lattice
# redifne regions
region          bbox delete
region          bbox block EDGE EDGE EDGE EDGE EDGE EDGE
variable        sublat equal ${bottom}+1/2
region          anchor delete
region          anchor block INF INF INF INF ${bottom} ${sublat} units lattice

# add new anchored atoms
create_atoms	1 region anchor
# redefine groups
group 	        anchor clear
group 	        anchor region anchor
group 	        mobile clear
group 	        mobile subtract all anchor
group           carbon clear
group           carbon type 1
# # reset n_lat_0 # not doing this anymore. It is goofy and overly complex.
# variable        n_lat_0  equal $(count(carbon))
# print           'N_LAT_0 ${n_lat_0}'

# add another layer if necessary
variable        ncarbon equal count(carbon)
