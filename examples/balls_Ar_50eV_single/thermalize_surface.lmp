# thermalize_surface.lmp — generated by DiamondEtchMD
# Standalone: loads data_file, thermalizes to T K, writes thermalized.data.
# No stopclust or impact fixes — safe for multi-cluster surfaces.
package kokkos neigh/qeq full neigh half newton on
units		real
include     config.lmp
if "${pot} == COMB3" then &
"atom_style charge" &
elif "${pot} == REAX" &
"atom_style charge" &
else &
"atom_style atomic"

boundary	p p m

read_data   ${data_file}

region      bbox block EDGE EDGE EDGE EDGE EDGE EDGE
region      anchor block INF INF INF INF INF ${anchor_z_max} units box

group       anchor region anchor
group       carbon type 1
group       hydrogen type 2
group       oxygen type 3
group       insert empty
group       mobile subtract all anchor

mass        1 ${M_C}
mass        2 ${M_H}
mass        3 ${M_O}
mass        4 ${M_Ar}

if "${pot} == REAX" then &
"pair_style  hybrid reaxff NULL zbl 5.0 6.0" &
"pair_coeff * * reaxff ffield.reax C H O NULL" &
"pair_coeff 1 4 zbl 6.0 18.0" &
"pair_coeff 2 4 zbl 1.0 18.0" &
"pair_coeff 3 4 zbl 8.0 18.0" &
"pair_coeff 4 4 zbl 18.0 18.0" &
"group nonargon type 1 2 3" &
"fix reax_qeq nonargon qeq/reaxff 1 0.0 6.0 1e-6 reaxff"

compute     mtemp mobile temp
compute_modify mtemp dynamic/dof yes
thermo      1000
thermo_style custom step time temp
thermo_modify temp mtemp
thermo_modify lost warn flush yes

# CG minimization
fix         minimfreeze anchor setforce 0.0 0.0 0.0
min_style   cg
minimize    1.0e-4 1.0e-6 1000 10000
unfix       minimfreeze

# NVT equilibration (30,000 steps)
velocity    mobile create ${T} 459087
fix         therm_init mobile nvt temp ${T} ${T} 100.0
run         30000
unfix       therm_init

write_data  initial_config_${T}K.data
write_data  thermalized.data nofix nocoeff
print '# trial surf_z_before_A ion_z_after_A ion_in_box pen_depth_A' file impact_stats.txt
