# head.lmp — generated by DiamondEtchMD (single-impact statistics mode)
# carbon-etch  species=Ar  50.0eV  300.0K  n_trials=100
package kokkos neigh/qeq full neigh half newton on
units		real
include     config.lmp
if "${pot} == COMB3" then &
"atom_style charge" &
elif "${pot} == REAX" &
"atom_style charge" &
else &
"atom_style atomic"

boundary	p p m

# ── Load initial structure ──────────────────────────────────────────
read_data   ${data_file}

# Anchor: frozen slab below anchor_z_max (Å)
region          bbox block EDGE EDGE EDGE EDGE EDGE EDGE
region          anchor block INF INF INF INF INF ${anchor_z_max} units box
variable        channeling_z equal bound(anchor,zmin)-2.0

# ── Groups, masses, potential ───────────────────────────────────────
group       anchor region anchor
group       insert empty
group       carbon type 1
group       hydrogen type 2
group       oxygen type 3
group       mobile subtract all anchor

variable    n_anchor_2x equal 2*count(anchor)

mass        1 ${M_C}
mass        2 ${M_H}
mass        3 ${M_O}
mass        4 ${M_Ar}

if "${pot} == REAX" then &
"pair_style  hybrid reaxff NULL zbl 5.0 6.0" &
"pair_coeff * * reaxff ffield.reax C H O NULL" &
"pair_coeff 1 4 zbl 6.0 18.0" &
"pair_coeff 2 4 zbl 1.0 18.0" &
"pair_coeff 3 4 zbl 8.0 18.0" &
"pair_coeff 4 4 zbl 18.0 18.0" &
"group nonargon type 1 2 3" &
"fix reax_qeq nonargon qeq/reaxff 1 0.0 6.0 1e-6 reaxff"

# ── Velocity components (set once; same each trial for same energy/angle) ──
variable 	vel equal sqrt(2*${energ}*6.02214129*1.0e+7/${M_incident}/6242)/1000
variable 	velz equal cos(${ion_angl}*PI/180)*${vel}
variable 	vely equal sin(${ion_angl}*PI/180)*${vel}

# ── Computes ────────────────────────────────────────────────────────
compute     ake all ke
compute     ape all pe
compute     ike insert ke
variable    ate equal c_ake+c_ape+ecouple

variable	checkevery equal 1000
compute	    clusts all cluster/atom 3.0
compute	    clust_min all reduce min c_clusts
compute	    clust_max all reduce max c_clusts
variable    one_clust equal "c_clust_min == c_clust_max"
fix		    stopclust all halt ${checkevery} v_one_clust == 0 error continue message yes

compute     cclusts carbon cluster/atom 1.8
compute     cc1 carbon chunk/atom c_cclusts compress yes
compute     nclusts carbon reduce max c_cc1

variable	nfixed   equal count(anchor)
variable	nmobile  equal count(mobile)
variable	ninject  equal count(insert)

thermo_style    custom step time v_ninject temp c_ike dt ecouple v_ate v_one_clust c_nclusts
compute     	mtemp mobile temp
compute_modify  mtemp dynamic/dof yes
thermo_modify   temp mtemp
thermo_modify   lost warn flush yes

variable    event_count equal ${n_events}

# ── Trial loop ──────────────────────────────────────────────────────
# Initialize trial counter the same way 'c' works in regular mode:
# ${}-substitute the index var to get a literal number, then increment inside.
variable    trial equal ${n_complete}
variable    trial_remaining equal $(v_n_trials)-${n_complete}
variable    trial_iter loop ${trial_remaining}

label		trial_start

# Increment trial counter (same pattern as 'c' in regular head.lmp)
variable    trial equal ${trial}+1
variable    c equal ${trial}

# Reset surface to thermalized state; re-establish all groups and QEQ fix
unfix       reax_qeq
delete_atoms group all
read_data   thermalized.data add 0

# Re-establish all groups; read_data zeros per-atom group membership
group       anchor region anchor
group       carbon type 1
group       hydrogen type 2
group       oxygen type 3
group       nonargon type 1 2 3
group       insert empty
group       mobile subtract all anchor

fix         reax_qeq nonargon qeq/reaxff 1 0.0 6.0 1e-6 reaxff

velocity    all create ${T} $(v_trial*1000003+0*7+1) dist gaussian
variable    cn equal 0
variable    cn_start equal 0

# Snapshot surface z BEFORE impact using immediate $() evaluation
region      bbox delete
region      bbox block EDGE EDGE EDGE EDGE EDGE EDGE
run         0 post no
variable    surf_z_before equal $(bound(carbon,zmax))

dump current_dump all custom 100 etch_event_trajs/event_dump_${c}.dump id type x y z vx vy vz fx fy fz q
variable    deposeed equal floor(random(1,72099+${seed_adjust},${trial}))
fix     depo insert deposit 1 ${incident_type_index} 10000000000 ${deposeed} global ${i_above} ${i_above} vx 0.0 0.0 vy ${vely} ${vely} vz -${velz} -${velz} region bbox units box

fix     2 mobile nve
fix     3 insert nve

timestep 1e-10
run 1 post no
variable starting_nclusts equal $(c_nclusts)

fix ats all dt/reset 1 NULL 1.00 0.01 units box
thermo      100

variable    t0 equal $(time)
variable    time_elapsed equal time-${t0}
fix         thalt all halt 1 v_time_elapsed > ${impact_time} error continue message yes

run         0 post no
variable    n_channelled equal 0
# =========================== begin inner loop ===========================
label		continue_impact

run         1000000000 pre no post no
run         0
if "$(c_nclusts) > ${starting_nclusts}" then &
"variable event_count equal ${event_count}+1" &
"variable starting_nclusts equal $(c_nclusts)"
if "${one_clust} == 0" then &
"include sweep.lmp" &
"region channelled block INF INF INF INF INF ${channeling_z} units box" &
"group channelled_group region channelled" &
"variable n_channelled equal count(channelled_group)" &
"region channelled delete" &

if "${n_channelled} > 0" then &
"variable event_count equal ${event_count}+1" &
"delete_atoms group channelled_group" &
"run 0" &
"group channelled_group delete" &
"variable n_channelled equal 0" &
"print 'Impact ${c}: atom channeled below anchor region.' append ATOM_CHANNELED"

if "$(time-v_t0) < ${impact_time}" then "jump SELF continue_impact"
unfix thalt
# ============================ end inner loop ============================

unfix   depo
unfix   ats

include thermalize.lmp

unfix       2
unfix       3

group       argon type 4
delete_atoms group argon
group       argon delete

group       carbon type 1
group       hydrogen type 2
group       oxygen type 3
variable    ncarbon equal count(carbon)
variable    nhydrogen equal count(hydrogen)
variable    noxygen equal count(oxygen)

variable    ion_in_box equal count(insert)
if "${ion_in_box} > 0" then &
    "variable ion_z_after equal $(bound(insert,zmin))" &
else &
    "variable ion_z_after equal 9999.0"
variable    pen_depth equal ${surf_z_before}-${ion_z_after}
print "${trial} ${surf_z_before} ${ion_z_after} ${ion_in_box} ${pen_depth}" append impact_stats.txt

print "${trial} ${ncarbon} ${nhydrogen} ${noxygen}" append ncarbon.txt

write_data  impact_snaps/${trial}_0.data nofix nocoeff

undump current_dump
# Update restart counter after each completed trial
shell       echo ${trial} > ntrials_done.txt

next		trial_iter
jump		SELF trial_start
