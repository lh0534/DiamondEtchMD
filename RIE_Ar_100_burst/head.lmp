fix         burst_depo insert deposit 1 3 1 ${burst_seed7_1} attempt 50 vx ${vx_burst} ${vx_burst} vy ${vy_burst} ${vy_burst} vz ${vz_burst} ${vz_burst} region bzone7 near 2.0
fix         2 mobile nve
fix         3 insert nve
