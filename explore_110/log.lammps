# ── Thermalize (300 K) ───────────────────────────────────────────────
thermo          1000
thermo_style    custom step time temp pe
compute         mtemp mobile temp
compute_modify  mtemp dynamic/dof yes
thermo_modify   temp mtemp
WARNING: Temperature for thermo pressure is not for group all (src/thermo.cpp:520)
thermo_modify   lost warn flush yes

velocity    mobile create ${T} 459087
velocity    mobile create 300 459087
fix         1 mobile nvt temp $T $T $(100*dt)
fix         1 mobile nvt temp 300 $T $(100*dt)
fix         1 mobile nvt temp 300 300 $(100*dt)
fix         1 mobile nvt temp 300 300 100
timestep    1
run         10000
