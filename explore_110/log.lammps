package kokkos
# make_surf_110.lmp — build a C(110) diamond surface for visualization
#
# Standalone script for exploring the (110) surface structure.
# Produces:
#   110_0K.data   — minimized (0 K) surface
#   110_300K.data — thermalized (300 K) surface
#   110_0K.dump   — OVITO-friendly dump (0 K)
#   110_300K.dump — OVITO-friendly dump (300 K)
#
# Run:
#   lmp -in make_surf_110.lmp
#   # or on Della:
#   module load lammps/kokkos/gpu_della9_2022
#   srun lmp -k on g 1 -sf kk -in make_surf_110.lmp

package kokkos neigh/qeq full neigh half newton on
units       real
atom_style  charge
boundary    p p m

# ── Parameters ────────────────────────────────────────────────────────
variable    lat_a equal 3.5653871687699   # ReaxFF equilibrium diamond lattice constant (Å)
variable    T equal 300.0                 # thermalization temperature (K)

# Box size in lattice units — adjust these to explore different sizes
variable    x equal 4                     # [-110] direction
variable    y equal 6                     # [001] direction
variable    lat_top equal 5               # [110] direction (slab depth)
variable    z equal ${lat_top}+5          # total z height (slab + vacuum)
variable    z equal 5+5          

# ── Lattice ───────────────────────────────────────────────────────────
# Diamond (110): surface normal along [110]
#   x = [-1 1 0]  period = a/sqrt(2)  → spacing 1/sqrt(2)
#   y = [ 0 0 1]  period = a          → spacing 1
#   z = [ 1 1 0]  period = a/sqrt(2)  → spacing 1/sqrt(2)
lattice     diamond ${lat_a}             orient z 1 1 0             orient x -1 1 0             orient y 0 0 1             spacing $(2/sqrt(2)) 1 $(3/sqrt(2))             origin 0 0 0
lattice     diamond 3.5653871687699             orient z 1 1 0             orient x -1 1 0             orient y 0 0 1             spacing $(2/sqrt(2)) 1 $(3/sqrt(2))             origin 0 0 0
lattice     diamond 3.5653871687699             orient z 1 1 0             orient x -1 1 0             orient y 0 0 1             spacing 1.4142135623730949234 1 $(3/sqrt(2))             origin 0 0 0
lattice     diamond 3.5653871687699             orient z 1 1 0             orient x -1 1 0             orient y 0 0 1             spacing 1.4142135623730949234 1 2.1213203435596423851             origin 0 0 0
Lattice spacing in x,y,z = 5.0422189 3.5653872 7.5633283

variable    bottom equal -5/8   # start below z=0 to sit in a gap between layers

region      bbox block 0 ${x} 0 ${y} ${bottom} ${z} units lattice
region      bbox block 0 4 0 ${y} ${bottom} ${z} units lattice
region      bbox block 0 4 0 6 ${bottom} ${z} units lattice
region      bbox block 0 4 0 6 -0.625 ${z} units lattice
region      bbox block 0 4 0 6 -0.625 10 units lattice
create_box  3 bbox              # 3 types: C(1) H(2) O(3)
Created orthogonal box = (0 0 -4.7270802) to (20.168876 21.392323 75.633283)
  1 by 1 by 1 MPI processor grid

# ── Create slab ───────────────────────────────────────────────────────
region      lbox block -1e-6 ${x} -1e-6 ${y} ${bottom} ${lat_top} units lattice
region      lbox block -1e-6 4 -1e-6 ${y} ${bottom} ${lat_top} units lattice
region      lbox block -1e-6 4 -1e-6 6 ${bottom} ${lat_top} units lattice
region      lbox block -1e-6 4 -1e-6 6 -0.625 ${lat_top} units lattice
region      lbox block -1e-6 4 -1e-6 6 -0.625 5 units lattice
create_atoms 1 region lbox
Created 3264 atoms
  using lattice units in orthogonal box = (0 0 -4.7270802) to (20.168876 21.392323 75.633283)
  create_atoms CPU = 0.006 seconds

variable    sublat equal ${bottom}+1/2
variable    sublat equal -0.625+1/2
region      anchor block INF INF INF INF ${bottom} ${sublat} units lattice
region      anchor block INF INF INF INF -0.625 ${sublat} units lattice
region      anchor block INF INF INF INF -0.625 -0.125 units lattice

set group all charge 0.0
Setting atom values ...
  3264 settings made for charge

# ── Groups ────────────────────────────────────────────────────────────
group       anchor region anchor
288 atoms in group anchor
group       insert empty
0 atoms in group insert
group       mobile subtract all anchor
2976 atoms in group mobile
group       carbon type 1
3264 atoms in group carbon

variable    n_lat_0 equal count(carbon)
print       'N_LAT_0 ${n_lat_0}'
N_LAT_0 3264
print       'Box x: ${x}  y: ${y}  lat_top: ${lat_top}'
Box x: 4  y: 6  lat_top: 5

# ── Masses ────────────────────────────────────────────────────────────
mass        1 12.011      # C
mass        2 1.00784     # H
mass        3 16.0        # O

# ── Potential ─────────────────────────────────────────────────────────
pair_style  reaxff NULL
pair_coeff  * * ffield.reax C H O
Reading potential file ffield.reax with DATE: 2011-02-18
WARNING: Changed valency_val to valency_boc for X (src/REAXFF/reaxff_ffield.cpp:296)
fix         reax_qeq all qeq/reaxff 1 0.0 6.0 1e-6 reaxff

# ── Trim box and remove overlaps ─────────────────────────────────────
change_box  all x final 0 ${x} y final 0 ${y} z final ${bottom} ${z}
change_box  all x final 0 4 y final 0 ${y} z final ${bottom} ${z}
change_box  all x final 0 4 y final 0 6 z final ${bottom} ${z}
change_box  all x final 0 4 y final 0 6 z final -0.625 ${z}
change_box  all x final 0 4 y final 0 6 z final -0.625 10
Changing box ...
  orthogonal box = (0 0 -4.7270802) to (20.168876 21.392323 75.633283)
  orthogonal box = (0 0 -4.7270802) to (20.168876 21.392323 75.633283)
  orthogonal box = (0 0 -4.7270802) to (20.168876 21.392323 75.633283)
delete_atoms overlap $(sqrt(3)/8) all all
delete_atoms overlap 0.21650635094610964915 all all
